---
import AdminShell from '@/components/admin/admin-shell.astro';
import LoadingState from '@/components/primitives/loading-state.astro';
import EmptyState from '@/components/primitives/empty-state.astro';
import ErrorState from '@/components/primitives/error-state.astro';
import { API_BASE_URL } from 'astro:env/server';
import { createCostsLiveClient, type ExpenseEntry, type ExpenseTotals } from '@/lib/admin/costs-live-api';
import { formatMoney } from '@/lib/sales/cart';
import { INSTALLATION } from '@/lib/installation';

// El token viene de la sesión de servidor; el navegador nunca lo recibe.
const auth = await Astro.session?.get('auth');
if (!auth) {
  return Astro.redirect('/entrar?redirect=%2Fadmin%2Fgastos', 303);
}

const empresa = Astro.locals.empresa;
const empresaName = INSTALLATION.name;
const costs = createCostsLiveClient({ baseUrl: API_BASE_URL, token: auth.accessToken });

const PERIOD = /^\d{4}-(0[1-9]|1[0-2])$/;

function currentPeriod(): string {
  const now = new Date();
  return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
}

function periodRange(period: string): { from: string; to: string } {
  const [year, month] = period.split('-').map(Number);
  const lastDay = new Date(year, month, 0).getDate();
  return {
    from: `${period}-01`,
    to: `${period}-${String(lastDay).padStart(2, '0')}`,
  };
}

function defaultDate(period: string): string {
  const now = new Date();
  const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
  return today.startsWith(period) ? today : `${period}-01`;
}

const requested = Astro.url.searchParams.get('period');
const period = requested !== null && PERIOD.test(requested) ? requested : currentPeriod();
const { from, to } = periodRange(period);

const back = (params: Record<string, string>) =>
  new Response(null, {
    status: 303,
    headers: { location: `/admin/gastos?${new URLSearchParams({ period, ...params }).toString()}` },
  });

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('action') ?? '') !== 'expense') return back({ error: 'Acción no reconocida.' });

  const category = String(form.get('category') ?? '').trim();
  const description = String(form.get('description') ?? '').trim();
  const amountRaw = String(form.get('amount') ?? '').trim();
  const expenseDate = String(form.get('expenseDate') ?? '').trim() || defaultDate(period);
  const amount = Number(amountRaw);

  if (category.length === 0) return back({ error: 'Escribe la categoría del gasto.' });
  if (description.length === 0) return back({ error: 'Escribe la descripción del gasto.' });
  if (amountRaw.length === 0 || !Number.isFinite(amount) || amount < 0) {
    return back({ error: 'El monto debe ser un número mayor o igual a cero.' });
  }
  if (!/^\d{4}-\d{2}-\d{2}$/.test(expenseDate)) {
    return back({ error: 'Indica una fecha válida.' });
  }

  const result = await costs.createExpense({ category, description, amount, expenseDate });
  if (result.status === 'ok') return back({ ok: 'Gasto registrado.' });
  return back({ error: result.message });
}

let entries: ExpenseEntry[] = [];
let totals: ExpenseTotals | null = null;
let loadError: string | null = null;

const [listResult, totalsResult] = await Promise.all([
  costs.listExpenses(from, to),
  costs.expenseTotals(from, to),
]);
if (listResult.status === 'ok') entries = listResult.data.items;
else loadError = listResult.message;
if (totalsResult.status === 'ok') totals = totalsResult.data;
else loadError ??= totalsResult.message;

const total = totals?.total ?? entries.reduce((sum, entry) => sum + entry.amount, 0);
const okMessage = Astro.url.searchParams.get('ok');
const pageError = Astro.url.searchParams.get('error');
const status = empresa === null ? 'loading' : empresa.status;

const CATEGORY_SUGGESTIONS = [
  'ARRIENDO',
  'SERVICIOS',
  'SUELDOS',
  'INSUMOS',
  'MANTENIMIENTO',
  'TRANSPORTE',
  'OTROS',
];

const periodLabel = new Intl.DateTimeFormat('es-BO', { month: 'long', year: 'numeric' }).format(
  new Date(`${period}-01T12:00:00`),
);
---

<AdminShell title="Gastos" active="/admin/costos">
  <header class="adm-page-head">
    <h1>Gastos operativos</h1>
    <p class="adm-sub">
      Gastos por periodo de {empresaName}. Se registran con categoría, descripción, monto y fecha.
    </p>
  </header>

  {okMessage && <p class="adm-banner adm-banner--ok" role="status">{okMessage}</p>}
  {pageError && <p class="adm-banner adm-banner--error" role="alert">{pageError}</p>}

  {
    status === 'loading' ? (
      <LoadingState label="Cargando la configuración de la empresa…" />
    ) : status === 'unavailable' ? (
      <ErrorState message="No pudimos cargar la configuración de la empresa. Inténtalo de nuevo en unos minutos." />
    ) : loadError !== null ? (
      <ErrorState message="No pudimos cargar los gastos del periodo. Inténtalo de nuevo en unos minutos." />
    ) : (
      <>
        <section class="adm-card" aria-labelledby="periodo-title">
          <div class="adm-card-head">
            <h2 id="periodo-title">Periodo</h2>
            <span class="adm-chip">{periodLabel}</span>
          </div>
          <form class="adm-form" method="get">
            <div class="adm-field">
              <label for="period-select">Mes</label>
              <input id="period-select" name="period" type="month" value={period} required />
            </div>
            <div class="adm-actions">
              <button class="adm-btn adm-btn--ghost" type="submit">Ver periodo</button>
            </div>
          </form>
        </section>

        <section class="adm-card" aria-labelledby="registrar-title">
          <div class="adm-card-head">
            <h2 id="registrar-title">Registrar gasto</h2>
            <span class="adm-total">{formatMoney(total)} en el periodo</span>
          </div>

          <form class="adm-form" method="post">
            <input type="hidden" name="action" value="expense" />
            <div class="adm-field">
              <label for="expense-category">Categoría</label>
              <input
                id="expense-category"
                name="category"
                required
                maxlength="40"
                list="expense-categories"
                autocomplete="off"
                placeholder="ARRIENDO"
              />
              <datalist id="expense-categories">
                {CATEGORY_SUGGESTIONS.map((category) => <option value={category} />)}
              </datalist>
            </div>
            <div class="adm-field">
              <label for="expense-description">Descripción</label>
              <input
                id="expense-description"
                name="description"
                required
                maxlength="240"
                autocomplete="off"
                placeholder="Alquiler del local"
              />
            </div>
            <div class="adm-field">
              <label for="expense-amount">Monto (Bs)</label>
              <input
                id="expense-amount"
                name="amount"
                type="number"
                min="0"
                step="0.01"
                required
                autocomplete="off"
              />
            </div>
            <div class="adm-field">
              <label for="expense-date">Fecha</label>
              <input
                id="expense-date"
                name="expenseDate"
                type="date"
                value={defaultDate(period)}
                required
              />
            </div>
            <div class="adm-actions">
              <button class="adm-btn" type="submit">Registrar gasto</button>
            </div>
          </form>
        </section>

        {totals !== null && totals.byCategory.length > 0 && (
          <section class="adm-card" aria-labelledby="categorias-title">
            <div class="adm-card-head">
              <h2 id="categorias-title">Gastos por categoría</h2>
              <span class="adm-chip">{totals.byCategory.length}</span>
            </div>
            <ul class="rep-bars" aria-label="Gastos por categoría">
              {totals.byCategory.map((entry) => (
                <li class="rep-bar">
                  <span class="rep-bar-label">{entry.category}</span>
                  <span class="rep-bar-value">{formatMoney(entry.total)}</span>
                  <span class="rep-bar-track" aria-hidden="true">
                    <span
                      class="rep-bar-fill"
                      style={`width:${total > 0 ? Math.max((entry.total / total) * 100, 2) : 0}%`}
                    />
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="adm-card" aria-labelledby="lista-title">
          <div class="adm-card-head">
            <h2 id="lista-title">Gastos del periodo</h2>
            <span class="adm-chip">{entries.length}</span>
          </div>

          {entries.length === 0 ? (
            <EmptyState
              title="Sin gastos en el periodo"
              message={`No hay gastos registrados en ${periodLabel}.`}
            />
          ) : (
            <div class="adm-table-wrap">
              <table class="adm-table adm-table--cards">
                <thead>
                  <tr>
                    <th scope="col">Fecha</th>
                    <th scope="col">Categoría</th>
                    <th scope="col">Descripción</th>
                    <th scope="col">Monto</th>
                  </tr>
                </thead>
                <tbody>
                  {entries.map((entry) => (
                    <tr>
                      <td data-label="Fecha">{new Date(`${entry.expenseDate}T12:00:00`).toLocaleDateString('es-BO')}</td>
                      <td data-label="Categoría"><span class="adm-chip">{entry.category}</span></td>
                      <td data-label="Descripción">{entry.description}</td>
                      <td data-label="Monto" class="adm-num">{formatMoney(entry.amount)}</td>
                    </tr>
                  ))}
                </tbody>
                <tfoot>
                  <tr>
                    <th scope="row" colspan="3">Total del periodo</th>
                    <td data-label="Total" class="adm-num">{formatMoney(total)}</td>
                  </tr>
                </tfoot>
              </table>
            </div>
          )}
        </section>
      </>
    )
  }
</AdminShell>
