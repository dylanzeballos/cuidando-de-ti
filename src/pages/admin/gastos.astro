---
import AdminShell from '@/components/admin/admin-shell.astro';
import ExpenseBars from '@/components/admin/expense-bars.astro';
import ExpenseFilters from '@/components/admin/expense-filters.astro';
import ExpenseForm from '@/components/admin/expense-form.astro';
import ExpensesMetrics from '@/components/admin/expenses-metrics.astro';
import ExpensesTable from '@/components/admin/expenses-table.astro';
import LoadingState from '@/components/primitives/loading-state.astro';
import EmptyState from '@/components/primitives/empty-state.astro';
import ErrorState from '@/components/primitives/error-state.astro';
import { API_BASE_URL } from 'astro:env/server';
import { createAdminClient, type Branch } from '@/lib/admin/catalog-api';
import {
  createCostsLiveClient,
  type ExpenseEntry,
  type ExpenseTotals,
} from '@/lib/admin/costs-live-api';
import { handleExpensePost } from '@/lib/admin/costs-post';
import { EXPENSE_CATEGORY_SUGGESTIONS, expenseMetrics } from '@/lib/admin/costs-ui';
import { redirectWith } from '@/lib/admin/redirect';
import { INSTALLATION } from '@/lib/installation';

// El token viene de la sesión de servidor; el navegador nunca lo recibe.
const auth = await Astro.session?.get('auth');
if (!auth) {
  return Astro.redirect('/entrar?redirect=%2Fadmin%2Fgastos', 303);
}

const empresa = Astro.locals.empresa;
const empresaName = INSTALLATION.name;
const catalog = createAdminClient({ baseUrl: API_BASE_URL, token: auth.accessToken });
const costs = createCostsLiveClient({ baseUrl: API_BASE_URL, token: auth.accessToken });

const PERIOD = /^\d{4}-(0[1-9]|1[0-2])$/;

function currentPeriod(): string {
  const now = new Date();
  return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
}

function periodRange(period: string): { from: string; to: string } {
  const [year, month] = period.split('-').map(Number);
  const lastDay = new Date(year, month, 0).getDate();
  return { from: `${period}-01`, to: `${period}-${String(lastDay).padStart(2, '0')}` };
}

function defaultDate(period: string): string {
  const now = new Date();
  const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(
    now.getDate(),
  ).padStart(2, '0')}`;
  return today.startsWith(period) ? today : `${period}-01`;
}

const requested = Astro.url.searchParams.get('period');
const period = requested !== null && PERIOD.test(requested) ? requested : currentPeriod();
const category = (Astro.url.searchParams.get('category') ?? '').trim();
const branchFilter = Astro.url.searchParams.get('branchId') ?? '';
const { from, to } = periodRange(period);
const filters = {
  ...(category ? { category } : {}),
  ...(branchFilter ? { branchId: branchFilter } : {}),
};

const back = (params: Record<string, string>) =>
  redirectWith('/admin/gastos', {
    period,
    ...(category ? { category } : {}),
    ...(branchFilter ? { branchId: branchFilter } : {}),
    ...params,
  });

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('action') ?? '') !== 'expense') {
    return back({ error: 'Acción no reconocida.' });
  }
  const result = await handleExpensePost(form, costs, defaultDate(period));
  if (result.status === 'ok') return back({ ok: result.message });
  return back({ ...(result.form ? { form: result.form } : {}), error: result.message });
}

let branches: Branch[] = [];
let entries: ExpenseEntry[] = [];
let totals: ExpenseTotals | null = null;
let loadError: string | null = null;

const [branchesResult, listResult, totalsResult] = await Promise.all([
  catalog.listBranches(),
  costs.listExpenses(from, to, filters),
  costs.expenseTotals(from, to, filters),
]);
if (branchesResult.status === 'ok') branches = branchesResult.data;
if (listResult.status === 'ok') entries = listResult.data.items;
else loadError = listResult.message;
if (totalsResult.status === 'ok') totals = totalsResult.data;
else loadError ??= totalsResult.message;

const total = totals?.total ?? entries.reduce((sum, entry) => sum + entry.amount, 0);
const byCategory = totals?.byCategory ?? [];
const metrics = expenseMetrics(total, entries.length, byCategory.length);
const branchName = new Map(branches.map((branch) => [branch.id, `${branch.code} · ${branch.name}`]));
const openForm = Astro.url.searchParams.get('form') ?? '';
const okMessage = Astro.url.searchParams.get('ok');
const pageError = Astro.url.searchParams.get('error');
const status = empresa === null ? 'loading' : empresa.status;

const periodLabel = new Intl.DateTimeFormat('es-BO', { month: 'long', year: 'numeric' }).format(
  new Date(`${period}-01T12:00:00`),
);
---

<AdminShell title="Gastos" active="/admin/costos">
  <header class="adm-page-head adm-page-head--row">
    <div>
      <h1>Gastos operativos</h1>
      <p class="adm-sub">
        Gastos por periodo de {empresaName}. Se registran con categoría, descripción, monto y
        fecha.
      </p>
    </div>
    <div class="adm-page-actions">
      <button
        class="adm-btn adm-btn--small"
        type="button"
        data-dialog-target="expense-dialog"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M12 5v14M5 12h14" />
        </svg>
        Registrar gasto
      </button>
    </div>
  </header>

  {okMessage && <p class="adm-banner adm-banner--ok" role="status">{okMessage}</p>}
  {pageError && <p class="adm-banner adm-banner--error" role="alert">{pageError}</p>}

  {
    status === 'loading' ? (
      <LoadingState label="Cargando la configuración de la empresa…" />
    ) : status === 'unavailable' ? (
      <ErrorState message="No pudimos cargar la configuración de la empresa. Inténtalo de nuevo en unos minutos." />
    ) : loadError !== null ? (
      <ErrorState message="No pudimos cargar los gastos del periodo. Inténtalo de nuevo en unos minutos." />
    ) : (
      <>
        <ExpensesMetrics metrics={metrics} />

        <section class="adm-card" aria-labelledby="filtros-title">
          <div class="adm-card-head">
            <h2 id="filtros-title">Periodo y filtros</h2>
            <span class="adm-chip">{periodLabel}</span>
          </div>
          <ExpenseFilters
            period={period}
            category={category}
            branchId={branchFilter}
            branches={branches}
            suggestions={EXPENSE_CATEGORY_SUGGESTIONS}
          />
        </section>

        {byCategory.length > 0 && <ExpenseBars byCategory={byCategory} total={total} />}

        <section class="adm-card" aria-labelledby="lista-title">
          <div class="adm-card-head">
            <h2 id="lista-title">Gastos del periodo</h2>
            <span class="adm-chip">
              {entries.length} {entries.length === 1 ? 'registrado' : 'registrados'}
            </span>
          </div>

          {entries.length === 0 ? (
            <EmptyState
              title="Sin gastos en el periodo"
              message={`No hay gastos registrados en ${periodLabel} con estos filtros.`}
            />
          ) : (
            <ExpensesTable entries={entries} branchName={branchName} total={total} />
          )}
        </section>

        <ExpenseForm
          branches={branches}
          defaultDate={defaultDate(period)}
          defaultBranchId={branchFilter}
          suggestions={EXPENSE_CATEGORY_SUGGESTIONS}
          open={openForm === 'expense'}
        />
      </>
    )
  }
</AdminShell>
