---
import AdminShell from '@/components/admin/admin-shell.astro';
import BranchForm from '@/components/admin/branch-form.astro';
import InventoryBranchCard from '@/components/admin/inventory-branch-card.astro';
import InventoryHeader from '@/components/admin/inventory-header.astro';
import InventoryMetrics from '@/components/admin/inventory-metrics.astro';
import InventoryStockCard from '@/components/admin/inventory-stock-card.astro';
import MovementForm from '@/components/admin/movement-form.astro';
import TransferForm from '@/components/admin/transfer-form.astro';
import LoadingState from '@/components/primitives/loading-state.astro';
import EmptyState from '@/components/primitives/empty-state.astro';
import ErrorState from '@/components/primitives/error-state.astro';
import { API_BASE_URL } from 'astro:env/server';
import { createAdminClient, type Branch, type Product } from '@/lib/admin/catalog-api';
import {
  countLowStock,
  countUnregistered,
  filterStockProducts,
  LOW_STOCK_THRESHOLD,
  parseStockFilter,
} from '@/lib/admin/inventory';
import { handleInventoryPost, loadStockByProduct } from '@/lib/admin/inventory-page';
import { redirectWith } from '@/lib/admin/redirect';
import { INSTALLATION } from '@/lib/installation';

// El token viene de la sesión de servidor; el navegador nunca lo recibe.
const auth = await Astro.session?.get('auth');
if (!auth) {
  return Astro.redirect('/entrar?redirect=%2Fadmin%2Finventario', 303);
}
const empresa = Astro.locals.empresa;
const empresaName = INSTALLATION.name;
const client = createAdminClient({ baseUrl: API_BASE_URL, token: auth.accessToken });

const query = (Astro.url.searchParams.get('q') ?? '').trim();
const stockFilter = parseStockFilter(Astro.url.searchParams.get('estado'));
const requestedBranchId = Astro.url.searchParams.get('branchId') ?? '';

const back = (params: Record<string, string>) =>
  redirectWith('/admin/inventario', {
    ...(query ? { q: query } : {}),
    ...(stockFilter !== 'todos' ? { estado: stockFilter } : {}),
    ...(requestedBranchId ? { branchId: requestedBranchId } : {}),
    ...params,
  });

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const result = await handleInventoryPost(form, client);

  if (result.status === 'ok') {
    return back({
      ...(result.branchId ? { branchId: result.branchId } : {}),
      ok: result.message,
    });
  }

  return back({
    ...(result.branchId ? { branchId: result.branchId } : {}),
    ...(result.form ? { form: result.form } : {}),
    error: result.message,
  });
}

let branches: Branch[] = [];
let products: Product[] = [];
let loadError: string | null = null;

const [branchesResult, productsResult] = await Promise.all([
  client.listBranches(),
  client.listProducts({ active: true }),
]);
if (branchesResult.status === 'ok') branches = branchesResult.data;
else loadError = branchesResult.message;
if (productsResult.status === 'ok') products = productsResult.data.items;
else loadError ??= productsResult.message;

const selectedBranch =
  branches.find((branch) => branch.id === requestedBranchId) ?? branches[0] ?? null;
const stockByProduct =
  selectedBranch === null
    ? new Map<string, number>()
    : await loadStockByProduct(client, selectedBranch.id, products);

const filteredProducts = filterStockProducts(products, stockByProduct, query, stockFilter);
const lowStock = countLowStock(products, stockByProduct);
const unregistered = countUnregistered(products, stockByProduct);
const openForm = Astro.url.searchParams.get('form') ?? '';
const okMessage = Astro.url.searchParams.get('ok');
const pageError = Astro.url.searchParams.get('error');
const status = empresa === null ? 'loading' : empresa.status;
---

<AdminShell title="Inventario" active="/admin/inventario">
  <InventoryHeader
    empresaName={empresaName}
    canOperate={branches.length > 0 && products.length > 0}
  />

  {okMessage && <p class="adm-banner adm-banner--ok" role="status">{okMessage}</p>}
  {pageError && <p class="adm-banner adm-banner--error" role="alert">{pageError}</p>}
  {loadError && <p class="adm-banner adm-banner--error" role="alert">{loadError}</p>}

  {
    status === 'loading' ? (
      <LoadingState label="Cargando el inventario…" />
    ) : status === 'unavailable' ? (
      <ErrorState message="No pudimos cargar la configuración de la empresa. Inténtalo de nuevo en unos minutos." />
    ) : (
      <>
        <InventoryMetrics
          branches={branches.length}
          products={products.length}
          lowStock={lowStock}
          unregistered={unregistered}
        />

        <InventoryBranchCard
          branches={branches}
          selectedBranchId={selectedBranch?.id ?? ''}
        />

        {branches.length === 0 || products.length === 0 ? (
          <EmptyState
            title="Falta información"
            message="Crea al menos una sucursal y un producto para operar el inventario."
          />
        ) : null}

        {selectedBranch && (
          <InventoryStockCard
            branch={selectedBranch}
            products={products}
            filteredProducts={filteredProducts}
            stockByProduct={stockByProduct}
            threshold={LOW_STOCK_THRESHOLD}
            lowStock={lowStock}
            query={query}
            stockFilter={stockFilter}
          />
        )}

        <BranchForm open={openForm === 'branch'} />
        {products.length > 0 && (
          <MovementForm
            branches={branches}
            products={products}
            selectedBranchId={selectedBranch?.id ?? ''}
            open={openForm === 'movement'}
          />
        )}
        {products.length > 0 && (
          <TransferForm
            branches={branches}
            products={products}
            selectedBranchId={selectedBranch?.id ?? ''}
            open={openForm === 'transfer'}
          />
        )}
      </>
    )
  }
</AdminShell>
