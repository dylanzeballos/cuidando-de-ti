---
import AdminShell from '@/components/admin/admin-shell.astro';
import LoadingState from '@/components/primitives/loading-state.astro';
import ErrorState from '@/components/primitives/error-state.astro';
import ModulePlaceholder from '@/components/admin/module-placeholder.astro';
import { INSTALLATION } from '@/lib/installation';

// El middleware garantiza la sesión y adjunta la empresa desde el servidor. El
// registro de clientes aún no tiene contrato de backend: se muestra su estado.
const empresa = Astro.locals.empresa;
const empresaName = empresa?.name ?? INSTALLATION.name;
const status = empresa === null ? 'loading' : empresa.status;
---

<AdminShell title="Clientes" active="/admin/clientes">
  <header class="adm-page-head">
    <h1>Pacientes y clientes</h1>
    <p class="adm-sub">Relaciones, historial y saldos de {empresaName}.</p>
  </header>

  {
    status === 'loading' ? (
      <LoadingState label="Cargando la configuración de la empresa…" />
    ) : status === 'unavailable' ? (
      <ErrorState message="No pudimos cargar la configuración de la empresa. Inténtalo de nuevo en unos minutos." />
    ) : (
      <ModulePlaceholder
        title="Directorio de pacientes y clientes"
        description="Este módulo se activa cuando el backend publica el contrato de clientes y la empresa lo contrata. Hasta entonces las ventas se registran sin identificar al cliente."
        items={[
          'Directorio con datos de contacto',
          'Historial de compras por cliente',
          'Crédito, saldos y recordatorios',
        ]}
        ctaHref="/admin/ventas"
        ctaLabel="Ir al registro de venta"
      />
    )
  }
</AdminShell>
