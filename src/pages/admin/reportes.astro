---
import AdminShell from '@/components/admin/admin-shell.astro';
import ChartRuntime from '@/components/reports/chart-runtime.astro';
import ReportsHeader from '@/components/reports/reports-header.astro';
import ReportsInventory from '@/components/reports/reports-inventory.astro';
import ReportsKpis from '@/components/reports/reports-kpis.astro';
import ReportsVisuals from '@/components/reports/reports-visuals.astro';
import { buildReportView, type ReportPeriod } from '@/lib/admin/reports';
import { loadReportsData } from '@/lib/admin/reports-service';

// El token viene de la sesión de servidor; el navegador nunca lo recibe. El
// panel se renderiza completo en servidor y solo los gráficos se hidratan.
const auth = await Astro.session?.get('auth');
if (!auth) {
  return Astro.redirect('/entrar?redirect=%2Fadmin%2Freportes', 303);
}

const rawPeriod = Astro.url.searchParams.get('periodo');
const months: ReportPeriod = rawPeriod === '3' ? 3 : rawPeriod === '12' ? 12 : 6;

const data = await loadReportsData(auth.accessToken, months);
const view = buildReportView({
  sales: data.sales,
  products: data.products,
  categories: data.categories,
  branches: data.branches,
  margins: data.margins,
  expenses: data.expenses,
  previousExpenses: data.previousExpenses,
  stockByProduct: data.stockByProduct,
  months,
});

const hasStockData = Object.keys(data.stockByProduct).length > 0;
---

<AdminShell title="Reportes" active="/admin/reportes">
  <ReportsHeader
    months={months}
    periodLabel={view.periodLabel}
    partial={data.partial}
    messages={data.messages}
  />

  <ReportsKpis stats={view.stats} />

  <ReportsVisuals view={view} />

  <ReportsInventory view={view} hasStockData={hasStockData} />

  <p class="rep-source">
    Cálculo en servidor sobre ventas, catálogo, costos e inventario de la empresa. Los gráficos se
    dibujan en el navegador con Chart.js; importes en bolivianos (BOB).
  </p>

  <ChartRuntime />
</AdminShell>
