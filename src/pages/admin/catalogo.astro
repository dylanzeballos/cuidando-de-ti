---
import AdminShell from '@/components/admin/admin-shell.astro';
import LoadingState from '@/components/primitives/loading-state.astro';
import EmptyState from '@/components/primitives/empty-state.astro';
import ErrorState from '@/components/primitives/error-state.astro';
import { API_BASE_URL } from 'astro:env/server';
import { createAdminClient, type Category, type Product } from '@/lib/admin/catalog-api';
import { formatMoney } from '@/lib/sales/cart';
import { INSTALLATION } from '@/lib/installation';

// El token viene de la sesión de servidor; el navegador nunca lo recibe. El
// middleware ya garantiza la sesión para `/admin/**`.
const auth = await Astro.session?.get('auth');
if (!auth) {
  return Astro.redirect('/entrar?redirect=%2Fadmin%2Fcatalogo', 303);
}
const empresa = Astro.locals.empresa;
const empresaName = INSTALLATION.name;

const client = createAdminClient({ baseUrl: API_BASE_URL, token: auth.accessToken });

const redirectWith = (key: 'ok' | 'error', message: string) =>
  Astro.redirect(`/admin/catalogo?${key}=${encodeURIComponent(message)}`, 303);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  let result;
  if (action === 'category') {
    const name = String(form.get('name') ?? '').trim();
    if (name.length === 0) return redirectWith('error', 'Escribe el nombre de la categoría.');
    result = await client.createCategory(name);
  } else if (action === 'product') {
    const sku = String(form.get('sku') ?? '').trim();
    const name = String(form.get('name') ?? '').trim();
    const unitPrice = Number(form.get('unitPrice') ?? '0');
    const taxRate = Number(form.get('taxRate') ?? '0');
    if (sku.length === 0 || name.length === 0) {
      return redirectWith('error', 'El SKU y el nombre del producto son obligatorios.');
    }
    if (!Number.isFinite(unitPrice) || unitPrice < 0) {
      return redirectWith('error', 'El precio debe ser un número mayor o igual a cero.');
    }
    if (!Number.isFinite(taxRate) || taxRate < 0 || taxRate > 100) {
      return redirectWith('error', 'El impuesto debe estar entre 0 y 100.');
    }
    const categoryId = String(form.get('categoryId') ?? '').trim();
    result = await client.createProduct({
      sku,
      name,
      unit: String(form.get('unit') ?? 'UNIT'),
      unitPrice,
      taxRate,
      barcode: String(form.get('barcode') ?? '').trim() || null,
      categoryId: categoryId || null,
    });
  } else {
    return redirectWith('error', 'Acción no reconocida.');
  }

  if (result.status === 'ok') return redirectWith('ok', 'Operación realizada.');
  return redirectWith('error', result.message);
}

let categories: Category[] = [];
let products: Product[] = [];
let loadError: string | null = null;

const [categoriesResult, productsResult] = await Promise.all([
  client.listCategories(),
  client.listProducts(),
]);
if (categoriesResult.status === 'ok') categories = categoriesResult.data;
else loadError = categoriesResult.message;
if (productsResult.status === 'ok') products = productsResult.data.items;
else loadError ??= productsResult.message;

const categoryName = new Map(categories.map((category) => [category.id, category.name]));
const okMessage = Astro.url.searchParams.get('ok');
const pageError = Astro.url.searchParams.get('error');
const status = empresa === null ? 'loading' : empresa.status;

const unitLabels: Record<string, string> = {
  UNIT: 'Unidad',
  KG: 'Kilogramo',
  LITER: 'Litro',
  PACK: 'Paquete',
};
---

<AdminShell title="Catálogo" active="/admin/catalogo">
  <header class="adm-page-head">
    <h1>Catálogo</h1>
    <p class="adm-sub">
      {products.length} productos en {categories.length} categorías de {empresaName}.
    </p>
  </header>

  {okMessage && <p class="adm-banner adm-banner--ok" role="status">{okMessage}</p>}
  {pageError && <p class="adm-banner adm-banner--error" role="alert">{pageError}</p>}
  {loadError && <p class="adm-banner adm-banner--error" role="alert">{loadError}</p>}

  {
    status === 'loading' ? (
      <LoadingState label="Cargando el catálogo…" />
    ) : status === 'unavailable' ? (
      <ErrorState message="No pudimos cargar la configuración de la empresa. Inténtalo de nuevo en unos minutos." />
    ) : (
      <>
        <section class="adm-card" aria-labelledby="categorias-title">
          <div class="adm-card-head">
            <h2 id="categorias-title">Categorías</h2>
            <span class="adm-chip">{categories.length}</span>
          </div>

          <form class="adm-form" method="post">
            <input type="hidden" name="action" value="category" />
            <div class="adm-field">
              <label for="category-name">Nombre</label>
              <input
                id="category-name"
                name="name"
                required
                maxlength="120"
                placeholder="Analgésicos"
                autocomplete="off"
              />
            </div>
            <div class="adm-actions">
              <button class="adm-btn" type="submit">Crear categoría</button>
            </div>
          </form>

          {categories.length === 0 ? (
            <EmptyState
              title="Aún no hay categorías"
              message="Crea la primera para agrupar medicamentos y productos."
            />
          ) : (
            <ul class="adm-list" role="list">
              {categories.map((category) => (
                <li>
                  <span class="adm-chip">
                    {category.name}
                    {!category.active ? ' · inactiva' : ''}
                  </span>
                </li>
              ))}
            </ul>
          )}
        </section>

        <section class="adm-card" aria-labelledby="productos-title">
          <div class="adm-card-head">
            <h2 id="productos-title">Productos</h2>
            <span class="adm-chip">{products.length}</span>
          </div>

          <form class="adm-form" method="post">
            <input type="hidden" name="action" value="product" />
            <div class="adm-field">
              <label for="sku">SKU</label>
              <input id="sku" name="sku" required maxlength="64" placeholder="PARA-500" autocomplete="off" />
            </div>
            <div class="adm-field">
              <label for="name">Nombre</label>
              <input id="name" name="name" required maxlength="200" placeholder="Paracetamol 500 mg" autocomplete="off" />
            </div>
            <div class="adm-field">
              <label for="barcode">Código de barras</label>
              <input id="barcode" name="barcode" maxlength="64" inputmode="numeric" autocomplete="off" />
            </div>
            <div class="adm-field">
              <label for="unit">Unidad</label>
              <select id="unit" name="unit" required>
                <option value="UNIT">Unidad</option>
                <option value="KG">Kilogramo</option>
                <option value="LITER">Litro</option>
                <option value="PACK">Paquete</option>
              </select>
            </div>
            <div class="adm-field">
              <label for="unitPrice">Precio (Bs)</label>
              <input id="unitPrice" name="unitPrice" type="number" min="0" step="0.01" required />
            </div>
            <div class="adm-field">
              <label for="taxRate">Impuesto (%)</label>
              <input id="taxRate" name="taxRate" type="number" min="0" max="100" step="0.01" value="13" required />
            </div>
            <div class="adm-field">
              <label for="categoryId">Categoría</label>
              <select id="categoryId" name="categoryId">
                <option value="">Sin categoría</option>
                {categories
                  .filter((category) => category.active)
                  .map((category) => (
                    <option value={category.id}>{category.name}</option>
                  ))}
              </select>
            </div>
            <div class="adm-actions">
              <button class="adm-btn" type="submit">Crear producto</button>
            </div>
          </form>

          {products.length === 0 ? (
            <EmptyState
              title="Aún no hay productos"
              message="Registra el primero para empezar a vender."
            />
          ) : (
            <div class="adm-table-wrap">
              <table class="adm-table">
                <thead>
                  <tr>
                    <th scope="col">SKU</th>
                    <th scope="col">Producto</th>
                    <th scope="col">Categoría</th>
                    <th scope="col">Precio</th>
                    <th scope="col">Impuesto</th>
                    <th scope="col">Estado</th>
                  </tr>
                </thead>
                <tbody>
                  {products.map((product) => (
                    <tr>
                      <td>{product.sku}</td>
                      <td>
                        <strong>{product.name}</strong>
                        <div class="adm-cell-muted">{unitLabels[product.unit] ?? product.unit}</div>
                      </td>
                      <td>
                        {product.categoryId === null
                          ? '—'
                          : (categoryName.get(product.categoryId) ?? '—')}
                      </td>
                      <td class="adm-num">{formatMoney(product.unitPrice)}</td>
                      <td class="adm-num">{product.taxRate.toFixed(1)} %</td>
                      <td>
                        <span class={`adm-badge ${product.active ? 'adm-badge--on' : 'adm-badge--off'}`}>
                          {product.active ? 'Activo' : 'Inactivo'}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      </>
    )
  }
</AdminShell>
