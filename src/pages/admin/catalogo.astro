---
import AdminShell from '@/components/admin/admin-shell.astro';
import CatalogFilters from '@/components/admin/catalog-filters.astro';
import CatalogMetrics from '@/components/admin/catalog-metrics.astro';
import ProductForm from '@/components/admin/product-form.astro';
import ProductsTable from '@/components/admin/products-table.astro';
import LoadingState from '@/components/primitives/loading-state.astro';
import EmptyState from '@/components/primitives/empty-state.astro';
import ErrorState from '@/components/primitives/error-state.astro';
import { API_BASE_URL } from 'astro:env/server';
import { createAdminClient, type Category, type Product } from '@/lib/admin/catalog-api';
import { redirectWith } from '@/lib/admin/redirect';
import { INSTALLATION } from '@/lib/installation';

// El token viene de la sesión de servidor; el navegador nunca lo recibe.
const auth = await Astro.session?.get('auth');
if (!auth) {
  return Astro.redirect('/entrar?redirect=%2Fadmin%2Fcatalogo', 303);
}
const empresa = Astro.locals.empresa;
const empresaName = INSTALLATION.name;
const client = createAdminClient({ baseUrl: API_BASE_URL, token: auth.accessToken });

const query = (Astro.url.searchParams.get('q') ?? '').trim();
const categoryId = Astro.url.searchParams.get('categoryId') ?? '';
const estado = Astro.url.searchParams.get('estado') ?? '';
const activeFilter = estado === 'activos' ? true : estado === 'inactivos' ? false : undefined;

const back = (params: Record<string, string>) =>
  redirectWith('/admin/catalogo', {
    ...(query ? { q: query } : {}),
    ...(categoryId ? { categoryId } : {}),
    ...(estado ? { estado } : {}),
    ...params,
  });

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  if (action === 'category') {
    const name = String(form.get('name') ?? '').trim();
    if (name.length === 0) return back({ error: 'Escribe el nombre de la categoría.' });
    const result = await client.createCategory(name);
    if (result.status === 'ok') return back({ ok: 'Categoría creada.' });
    return back({ error: result.message });
  }

  if (action === 'product') {
    const sku = String(form.get('sku') ?? '').trim();
    const name = String(form.get('name') ?? '').trim();
    const unitPrice = Number(form.get('unitPrice') ?? '0');
    const taxRate = Number(form.get('taxRate') ?? '0');
    if (sku.length === 0 || name.length === 0) {
      return back({ error: 'El SKU y el nombre del producto son obligatorios.' });
    }
    if (!Number.isFinite(unitPrice) || unitPrice < 0) {
      return back({ error: 'El precio debe ser un número mayor o igual a cero.' });
    }
    if (!Number.isFinite(taxRate) || taxRate < 0 || taxRate > 100) {
      return back({ error: 'El impuesto debe estar entre 0 y 100.' });
    }
    const result = await client.createProduct({
      sku,
      name,
      unit: String(form.get('unit') ?? 'UNIT'),
      unitPrice,
      taxRate,
      barcode: String(form.get('barcode') ?? '').trim() || null,
      categoryId: String(form.get('categoryId') ?? '').trim() || null,
    });
    if (result.status === 'ok') return back({ ok: 'Producto creado.' });
    return back({ error: result.message });
  }

  return back({ error: 'Acción no reconocida.' });
}

let categories: Category[] = [];
let products: Product[] = [];
let total = 0;
let loadError: string | null = null;

const [categoriesResult, productsResult] = await Promise.all([
  client.listCategories(),
  client.listProducts({
    query: query || undefined,
    categoryId: categoryId || undefined,
    active: activeFilter,
  }),
]);
if (categoriesResult.status === 'ok') categories = categoriesResult.data;
else loadError = categoriesResult.message;
if (productsResult.status === 'ok') {
  products = productsResult.data.items;
  total = productsResult.data.total;
} else {
  loadError ??= productsResult.message;
}

const okMessage = Astro.url.searchParams.get('ok');
const pageError = Astro.url.searchParams.get('error');
const status = empresa === null ? 'loading' : empresa.status;
---

<AdminShell title="Catálogo" active="/admin/catalogo">
  <header class="adm-page-head">
    <h1>Catálogo</h1>
    <p class="adm-sub">
      Medicamentos y productos de {empresaName} con su precio, impuesto y categoría.
    </p>
  </header>

  {okMessage && <p class="adm-banner adm-banner--ok" role="status">{okMessage}</p>}
  {pageError && <p class="adm-banner adm-banner--error" role="alert">{pageError}</p>}
  {loadError && <p class="adm-banner adm-banner--error" role="alert">{loadError}</p>}

  {
    status === 'loading' ? (
      <LoadingState label="Cargando el catálogo…" />
    ) : status === 'unavailable' ? (
      <ErrorState message="No pudimos cargar la configuración de la empresa. Inténtalo de nuevo en unos minutos." />
    ) : (
      <>
        <CatalogMetrics total={total} products={products} categories={categories} />

        <ProductForm categories={categories} open={pageError !== null} />

        <div class="adm-catalog-grid">
          <section class="adm-card" aria-labelledby="categorias-title">
            <div class="adm-card-head">
              <h2 id="categorias-title">Categorías</h2>
              <span class="adm-chip">{categories.length}</span>
            </div>

            <form class="adm-inline-form" method="post">
              <input type="hidden" name="action" value="category" />
              <label class="adm-sr" for="category-name">Nueva categoría</label>
              <input
                id="category-name"
                name="name"
                required
                maxlength="120"
                placeholder="Nueva categoría…"
                autocomplete="off"
              />
              <button class="adm-btn adm-btn--small" type="submit">Agregar</button>
            </form>

            {categories.length === 0 ? (
              <p class="adm-note">Aún no hay categorías. Crea la primera para agrupar productos.</p>
            ) : (
              <ul class="adm-list" role="list">
                {categories.map((category) => (
                  <li>
                    <span class="adm-chip">
                      {category.name}
                      {!category.active ? ' · inactiva' : ''}
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </section>

          <section class="adm-card" aria-labelledby="productos-title">
            <div class="adm-card-head">
              <h2 id="productos-title">Productos</h2>
              <span class="adm-chip">{products.length} listados</span>
            </div>

            <CatalogFilters
              query={query}
              categoryId={categoryId}
              status={estado}
              categories={categories}
            />

            {products.length === 0 ? (
              <EmptyState
                title={loadError ? 'No se pudieron cargar los productos' : 'Sin productos para este filtro'}
                message={
                  loadError
                    ? 'Inténtalo de nuevo en unos minutos.'
                    : 'Prueba con otro filtro o crea el primero desde “Nuevo producto”.'
                }
              />
            ) : (
              <ProductsTable products={products} categories={categories} />
            )}
          </section>
        </div>
      </>
    )
  }
</AdminShell>
