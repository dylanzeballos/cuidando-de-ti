---
import AdminShell from '@/components/admin/admin-shell.astro';
import RoleForm from '@/components/admin/role-form.astro';
import RolesTable from '@/components/admin/roles-table.astro';
import LoadingState from '@/components/primitives/loading-state.astro';
import EmptyState from '@/components/primitives/empty-state.astro';
import ErrorState from '@/components/primitives/error-state.astro';
import { resolveIdentityClient } from '@/lib/admin/identity-service';
import { validateRoleName } from '@/lib/admin/identity-validation';
import { buildPermissionModuleLabels, countPermissions } from '@/lib/admin/identity-labels';
import { redirectWith } from '@/lib/admin/redirect';
import {
  filterSelectablePermissions,
  selectablePermissionCodes,
  selectablePermissionGroups,
} from '@/lib/module-catalog';
import type { Role, UserAccount } from '@/lib/admin/identity-api';
import { INSTALLATION } from '@/lib/installation';

// Todas las operaciones se resuelven en el servidor con el token de la sesión.
const auth = await Astro.session?.get('auth');
if (!auth) {
  return Astro.redirect('/entrar?redirect=%2Fadmin%2Froles', 303);
}

const client = resolveIdentityClient(auth.accessToken);
const empresa = Astro.locals.empresa;
const modules = empresa?.modules ?? [];
const empresaName = INSTALLATION.name;

const back = (params: Record<string, string>) => redirectWith('/admin/roles', params);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  if (action === 'save-role') {
    const roleId = String(form.get('roleId') ?? '').trim();
    const name = String(form.get('name') ?? '').trim();
    const description = String(form.get('description') ?? '').trim();
    const requested = form.getAll('permissions').map(String);

    if (validateRoleName(name) !== null) return back({ error: 'name-required', edit: roleId });

    const permissionsResult = await client.listPermissions();
    if (permissionsResult.status !== 'ok') return back({ error: permissionsResult.message });

    const permissions = filterSelectablePermissions(requested, permissionsResult.data, modules);
    const input = { name, description: description.length > 0 ? description : null, permissions };

    const result = roleId.length > 0
      ? await client.updateRole(roleId, input)
      : await client.createRole(input);

    if (result.status === 'ok') {
      return back({ ok: roleId.length > 0 ? 'Rol actualizado.' : 'Rol creado.' });
    }
    return back({ error: result.message, edit: roleId });
  }

  if (action === 'delete-role') {
    const roleId = String(form.get('roleId') ?? '').trim();
    const confirm = form.get('confirm') === '1';
    if (roleId.length === 0) return back({ error: 'Rol no válido.' });

    const rolesResult = await client.listRoles();
    if (rolesResult.status !== 'ok') return back({ error: rolesResult.message });
    const target = rolesResult.data.find((role) => role.id === roleId) ?? null;
    if (target === null) return back({ error: 'El rol ya no existe.' });

    let assignments: number | null = null;
    const usersResult = await client.listUsers();
    if (usersResult.status === 'ok') {
      assignments = usersResult.data.items.filter((user) => user.roles.includes(target.name)).length;
    }

    if (!confirm && assignments !== null && assignments > 0) return back({ warn: roleId });

    const result = await client.deleteRole(roleId);
    if (result.status === 'ok') return back({ ok: 'Rol eliminado.' });
    return back({ error: result.message, edit: roleId });
  }

  return back({ error: 'Acción no reconocida.' });
}

let roles: Role[] = [];
let users: UserAccount[] = [];
let permissionsGroups = selectablePermissionGroups([], modules);
let loadError: string | null = null;

const [rolesResult, permissionsResult, usersResult] = await Promise.all([
  client.listRoles(),
  client.listPermissions(),
  client.listUsers(),
]);
if (rolesResult.status === 'ok') roles = rolesResult.data;
else loadError = rolesResult.message;
if (permissionsResult.status === 'ok') {
  permissionsGroups = selectablePermissionGroups(permissionsResult.data, modules);
} else {
  loadError ??= permissionsResult.message;
}
if (usersResult.status === 'ok') users = usersResult.data.items;

const selectableCodes = permissionsResult.status === 'ok'
  ? selectablePermissionCodes(permissionsResult.data, modules)
  : new Set<string>();

const permissionModules = permissionsResult.status === 'ok'
  ? buildPermissionModuleLabels(permissionsResult.data)
  : new Map<string, string>();

const okMessage = Astro.url.searchParams.get('ok');
const errorMessage = Astro.url.searchParams.get('error');
const fieldError = errorMessage === 'name-required' ? 'Escribe el nombre del rol.' : null;
const pageError = errorMessage !== null && fieldError === null ? errorMessage : null;

const editId = Astro.url.searchParams.get('edit') ?? '';
const editingRole = roles.find((role) => role.id === editId) ?? null;
const hiddenPermissions =
  editingRole === null ? [] : editingRole.permissions.filter((code) => !selectableCodes.has(code));
const warnId = Astro.url.searchParams.get('warn') ?? '';
const warnRole = roles.find((role) => role.id === warnId) ?? null;
const warnAssignments =
  warnRole === null ? 0 : users.filter((user) => user.roles.includes(warnRole.name)).length;
const status = empresa === null ? 'loading' : empresa.status;
---

<AdminShell title="Roles" active="/admin/usuarios">
  <header class="adm-page-head">
    <h1>Roles y permisos</h1>
    <p class="adm-sub">Roles de {empresaName} con permisos por módulo habilitado.</p>
  </header>

  {okMessage && <p class="adm-banner adm-banner--ok" role="status">{okMessage}</p>}
  {pageError && <p class="adm-banner adm-banner--error" role="alert">{pageError}</p>}

  {
    status === 'loading' ? (
      <LoadingState label="Cargando la configuración de la empresa…" />
    ) : status === 'unavailable' ? (
      <ErrorState message="No pudimos cargar la configuración de la empresa. Inténtalo de nuevo en unos minutos." />
    ) : loadError ? (
      <ErrorState message={loadError} />
    ) : (
      <>
        <dl class="adm-metrics" aria-label="Resumen de roles">
          <div>
            <dt>Roles</dt>
            <dd>{roles.length}</dd>
          </div>
          <div>
            <dt>Permisos disponibles</dt>
            <dd>{countPermissions(permissionsGroups)}</dd>
          </div>
          <div>
            <dt>Módulos habilitados</dt>
            <dd>{modules.length}</dd>
          </div>
          <div>
            <dt>Usuarios</dt>
            <dd>{users.length}</dd>
          </div>
        </dl>

        {warnRole && (
          <>
            <p class="adm-banner adm-banner--warn" role="alert">
              El rol «{warnRole.name}» está asignado a {warnAssignments} usuario(s). No se elimina
              sin confirmación.
            </p>
            <form class="adm-actions" method="post">
              <input type="hidden" name="action" value="delete-role" />
              <input type="hidden" name="roleId" value={warnRole.id} />
              <input type="hidden" name="confirm" value="1" />
              <button class="adm-btn adm-btn--danger" type="submit">Confirmar eliminación</button>
            </form>
          </>
        )}

        <RoleForm
          editingRole={editingRole}
          fieldError={fieldError}
          permissionsGroups={permissionsGroups}
          hiddenPermissions={hiddenPermissions}
        />

        {roles.length === 0 ? (
          <EmptyState
            title="Aún no hay roles"
            message="Crea el primero para asignar permisos a tus usuarios."
          />
        ) : (
          <RolesTable roles={roles} permissionModules={permissionModules} />
        )}
      </>
    )
  }
</AdminShell>
