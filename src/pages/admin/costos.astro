---
import AdminShell from '@/components/admin/admin-shell.astro';
import CostFilters from '@/components/admin/cost-filters.astro';
import CostForm from '@/components/admin/cost-form.astro';
import CostsBranchCard from '@/components/admin/costs-branch-card.astro';
import CostsHeader from '@/components/admin/costs-header.astro';
import CostsMetrics from '@/components/admin/costs-metrics.astro';
import CostsTable from '@/components/admin/costs-table.astro';
import LoadingState from '@/components/primitives/loading-state.astro';
import EmptyState from '@/components/primitives/empty-state.astro';
import ErrorState from '@/components/primitives/error-state.astro';
import { API_BASE_URL } from 'astro:env/server';
import { createAdminClient, type Branch, type Product } from '@/lib/admin/catalog-api';
import { createCostsLiveClient, type CostMargin } from '@/lib/admin/costs-live-api';
import { handleCostPost } from '@/lib/admin/costs-post';
import {
  buildCostRows,
  costMetrics,
  filterCostRows,
  parseMarginStatus,
} from '@/lib/admin/costs-ui';
import { redirectWith } from '@/lib/admin/redirect';
import { INSTALLATION } from '@/lib/installation';

// El token viene de la sesión de servidor; el navegador nunca lo recibe.
const auth = await Astro.session?.get('auth');
if (!auth) {
  return Astro.redirect('/entrar?redirect=%2Fadmin%2Fcostos', 303);
}
const empresa = Astro.locals.empresa;
const empresaName = INSTALLATION.name;

const catalog = createAdminClient({ baseUrl: API_BASE_URL, token: auth.accessToken });
const costs = createCostsLiveClient({ baseUrl: API_BASE_URL, token: auth.accessToken });

const now = new Date();
const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(
  now.getDate(),
).padStart(2, '0')}`;

const query = (Astro.url.searchParams.get('q') ?? '').trim();
const marginStatus = parseMarginStatus(Astro.url.searchParams.get('estado'));
const requestedBranchId = Astro.url.searchParams.get('branchId') ?? '';

const back = (params: Record<string, string>) =>
  redirectWith('/admin/costos', {
    ...(query ? { q: query } : {}),
    ...(marginStatus !== 'todos' ? { estado: marginStatus } : {}),
    ...(requestedBranchId ? { branchId: requestedBranchId } : {}),
    ...params,
  });

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('action') ?? '') !== 'cost') {
    return back({ error: 'Acción no reconocida.' });
  }
  const result = await handleCostPost(form, costs);
  if (result.status === 'ok') {
    return back({
      ...(result.branchId ? { branchId: result.branchId } : {}),
      ok: result.message,
    });
  }
  return back({
    ...(result.branchId ? { branchId: result.branchId } : {}),
    ...(result.form ? { form: result.form } : {}),
    error: result.message,
  });
}

let branches: Branch[] = [];
let products: Product[] = [];
let margins: CostMargin[] = [];
let loadError: string | null = null;
let unauthorized = false;

const [branchesResult, productsResult] = await Promise.all([
  catalog.listBranches(),
  catalog.listProducts({ active: true }),
]);
if (branchesResult.status === 'ok') branches = branchesResult.data;
else loadError = branchesResult.message;
if (productsResult.status === 'ok') products = productsResult.data.items;
else loadError ??= productsResult.message;

const selectedBranch =
  branches.find((branch) => branch.id === requestedBranchId) ?? branches[0] ?? null;

if (selectedBranch !== null && loadError === null) {
  const marginsResult = await costs.listMargins(selectedBranch.id);
  if (marginsResult.status === 'ok') margins = marginsResult.data.items;
  else {
    unauthorized = marginsResult.status === 'unauthorized';
    loadError = marginsResult.message;
  }
}

const allRows = buildCostRows(products, margins);
const rows = filterCostRows(allRows, query, marginStatus);
const metrics = costMetrics(allRows);
const openForm = Astro.url.searchParams.get('form') ?? '';
const okMessage = Astro.url.searchParams.get('ok');
const pageError = Astro.url.searchParams.get('error');
const status = empresa === null ? 'loading' : empresa.status;

const unitLabels: Record<string, string> = {
  UNIT: 'Unidad',
  KG: 'Kilogramo',
  LITER: 'Litro',
  PACK: 'Paquete',
};
const canOperate = branches.length > 0 && products.length > 0;
---

<AdminShell title="Costos" active="/admin/costos">
  <CostsHeader empresaName={empresaName} canOperate={canOperate} />

  {okMessage && <p class="adm-banner adm-banner--ok" role="status">{okMessage}</p>}
  {pageError && <p class="adm-banner adm-banner--error" role="alert">{pageError}</p>}

  {
    status === 'loading' ? (
      <LoadingState label="Cargando la configuración de la empresa…" />
    ) : status === 'unavailable' ? (
      <ErrorState message="No pudimos cargar la configuración de la empresa. Inténtalo de nuevo en unos minutos." />
    ) : loadError !== null ? (
      <ErrorState
        title={unauthorized ? 'No autorizado' : 'No se pudo cargar'}
        message="No pudimos cargar los costos de la empresa. Verifica el permiso de costos e inténtalo de nuevo."
      />
    ) : branches.length === 0 ? (
      <EmptyState
        title="Aún no hay sucursales"
        message="Crea una sucursal en el inventario para registrar el costo por sucursal."
      >
        <a class="adm-link" href="/admin/inventario">Ir al inventario</a>
      </EmptyState>
    ) : products.length === 0 ? (
      <EmptyState
        title="Aún no hay productos"
        message="Registra productos en el catálogo para fijar su costo de compra."
      >
        <a class="adm-link" href="/admin/catalogo">Ir al catálogo</a>
      </EmptyState>
    ) : (
      <>
        <CostsMetrics metrics={metrics} />

        <CostsBranchCard
          branches={branches}
          selectedBranchId={selectedBranch?.id ?? ''}
        />

        <section class="adm-card" aria-labelledby="margenes-title">
          <div class="adm-card-head">
            <h2 id="margenes-title">Márgenes de {selectedBranch?.name}</h2>
            <span class="adm-chip">
              {rows.length} {rows.length === 1 ? 'listado' : 'listados'}
            </span>
          </div>

          <CostFilters
            query={query}
            status={marginStatus}
            branchId={selectedBranch?.id ?? ''}
          />

          {rows.length === 0 ? (
            <EmptyState
              title="Sin resultados"
              message="Prueba con otro texto o estado de costo."
            />
          ) : (
            <CostsTable
              rows={rows}
              branchId={selectedBranch?.id ?? ''}
              unitLabels={unitLabels}
            />
          )}

          <p class="adm-note">
            Un costo nuevo debe empezar después del último vigente para no solaparse. Usa
            <strong>+</strong> para agregar un costo y el <strong>lápiz</strong> para actualizarlo.
          </p>
        </section>

        {canOperate && (
          <CostForm
            branches={branches}
            products={products}
            selectedBranchId={selectedBranch?.id ?? ''}
            today={today}
            open={openForm === 'cost'}
          />
        )}
      </>
    )
  }
</AdminShell>
