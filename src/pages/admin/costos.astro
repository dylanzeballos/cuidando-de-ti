---
import AdminShell from '@/components/admin/admin-shell.astro';
import LoadingState from '@/components/primitives/loading-state.astro';
import EmptyState from '@/components/primitives/empty-state.astro';
import ErrorState from '@/components/primitives/error-state.astro';
import { API_BASE_URL } from 'astro:env/server';
import { createAdminClient, type Branch, type Product } from '@/lib/admin/catalog-api';
import { createCostsLiveClient, type CostMargin } from '@/lib/admin/costs-live-api';
import { formatMoney } from '@/lib/sales/cart';
import { INSTALLATION } from '@/lib/installation';

// El token viene de la sesión de servidor; el navegador nunca lo recibe. La
// empresa es implícita de la instalación.
const auth = await Astro.session?.get('auth');
if (!auth) {
  return Astro.redirect('/entrar?redirect=%2Fadmin%2Fcostos', 303);
}

const empresa = Astro.locals.empresa;
const empresaName = INSTALLATION.name;

const catalog = createAdminClient({ baseUrl: API_BASE_URL, token: auth.accessToken });
const costs = createCostsLiveClient({ baseUrl: API_BASE_URL, token: auth.accessToken });

function isoToday(): string {
  const now = new Date();
  const month = String(now.getMonth() + 1).padStart(2, '0');
  const day = String(now.getDate()).padStart(2, '0');
  return `${now.getFullYear()}-${month}-${day}`;
}

const back = (params: Record<string, string>) =>
  new Response(null, {
    status: 303,
    headers: { location: `/admin/costos?${new URLSearchParams(params).toString()}` },
  });

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  if (action !== 'cost') return back({ error: 'Acción no reconocida.' });

  const productId = String(form.get('productId') ?? '').trim();
  const branchId = String(form.get('branchId') ?? '').trim();
  const amountRaw = String(form.get('amount') ?? '').trim();
  const validFrom = String(form.get('validFrom') ?? '').trim() || isoToday();
  const amount = Number(amountRaw);

  if (branchId.length === 0) return back({ error: 'Elige la sucursal.', form: 'cost' });
  if (productId.length === 0) return back({ error: 'Elige el producto.', form: 'cost' });
  if (amountRaw.length === 0 || !Number.isFinite(amount) || amount < 0) {
    return back({ error: 'El costo debe ser un número mayor o igual a cero.', form: 'cost' });
  }
  if (!/^\d{4}-\d{2}-\d{2}$/.test(validFrom)) {
    return back({ error: 'Indica una fecha de vigencia válida.', form: 'cost' });
  }

  const result = await costs.createCost({ branchId, productId, costPrice: amount, validFrom });
  if (result.status === 'ok') return back({ branchId, ok: 'Costo registrado.' });
  return back({ branchId, form: 'cost', error: result.message });
}

let branches: Branch[] = [];
let products: Product[] = [];
let margins: CostMargin[] = [];
let loadError: string | null = null;
let unauthorized = false;

const [branchesResult, productsResult] = await Promise.all([
  catalog.listBranches(),
  catalog.listProducts({ active: true }),
]);
if (branchesResult.status === 'ok') branches = branchesResult.data;
else loadError = branchesResult.message;
if (productsResult.status === 'ok') products = productsResult.data.items;
else loadError ??= productsResult.message;

const selectedBranch =
  branches.find((branch) => branch.id === Astro.url.searchParams.get('branchId')) ?? branches[0] ?? null;

if (selectedBranch !== null && loadError === null) {
  const marginsResult = await costs.listMargins(selectedBranch.id);
  if (marginsResult.status === 'ok') {
    margins = marginsResult.data.items;
  } else {
    unauthorized = marginsResult.status === 'unauthorized';
    loadError = marginsResult.message;
  }
}

const marginByProduct = new Map(margins.map((margin) => [margin.productId, margin]));
const rows = products.map((product) => ({
  product,
  margin: marginByProduct.get(product.id) ?? null,
}));

const okMessage = Astro.url.searchParams.get('ok');
const pageError = Astro.url.searchParams.get('error');
const status = empresa === null ? 'loading' : empresa.status;

const unitLabels: Record<string, string> = {
  UNIT: 'Unidad',
  KG: 'Kilogramo',
  LITER: 'Litro',
  PACK: 'Paquete',
};
---

<AdminShell title="Costos" active="/admin/costos">
  <header class="adm-page-head">
    <h1>Costos y márgenes</h1>
    <p class="adm-sub">
      Costo de compra vigente por producto y sucursal de {empresaName}. El margen se calcula en el
      servidor frente al precio de venta.
    </p>
  </header>

  {okMessage && <p class="adm-banner adm-banner--ok" role="status">{okMessage}</p>}
  {pageError && <p class="adm-banner adm-banner--error" role="alert">{pageError}</p>}

  {
    status === 'loading' ? (
      <LoadingState label="Cargando la configuración de la empresa…" />
    ) : status === 'unavailable' ? (
      <ErrorState message="No pudimos cargar la configuración de la empresa. Inténtalo de nuevo en unos minutos." />
    ) : loadError !== null ? (
      <ErrorState
        title={unauthorized ? 'No autorizado' : 'No se pudo cargar'}
        message="No pudimos cargar los costos de la empresa. Verifica el permiso de costos e inténtalo de nuevo."
      />
    ) : branches.length === 0 ? (
      <EmptyState
        title="Aún no hay sucursales"
        message="Crea una sucursal en el inventario para registrar el costo por sucursal."
      >
        <a class="adm-link" href="/admin/inventario">Ir al inventario</a>
      </EmptyState>
    ) : products.length === 0 ? (
      <EmptyState
        title="Aún no hay productos"
        message="Registra productos en el catálogo para fijar su costo de compra."
      >
        <a class="adm-link" href="/admin/catalogo">Ir al catálogo</a>
      </EmptyState>
    ) : (
      <>
        <section class="adm-card" aria-labelledby="sucursal-title">
          <div class="adm-card-head">
            <h2 id="sucursal-title">Sucursal</h2>
            <span class="adm-chip">{branches.length}</span>
          </div>
          <ul class="adm-list" role="list">
            {branches.map((branch) => (
              <li>
                <a href={`/admin/costos?branchId=${encodeURIComponent(branch.id)}`}>
                  <span class={`adm-chip${selectedBranch?.id === branch.id ? ' adm-chip--on' : ''}`}>
                    {branch.code} · {branch.name}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section class="adm-card" aria-labelledby="registrar-title">
          <div class="adm-card-head">
            <h2 id="registrar-title">Registrar costo</h2>
            <span class="adm-chip">Vigencia desde</span>
          </div>

          <form class="adm-form" method="post">
            <input type="hidden" name="action" value="cost" />
            <div class="adm-field">
              <label for="cost-product">Producto</label>
              <select id="cost-product" name="productId" required>
                <option value="">Elige un producto</option>
                {products.map((product) => (
                  <option value={product.id}>
                    {product.sku} · {product.name}
                  </option>
                ))}
              </select>
            </div>
            <div class="adm-field">
              <label for="cost-branch">Sucursal</label>
              <select id="cost-branch" name="branchId" required>
                {branches.map((branch) => (
                  <option value={branch.id} selected={branch.id === selectedBranch?.id}>
                    {branch.code} · {branch.name}
                  </option>
                ))}
              </select>
            </div>
            <div class="adm-field">
              <label for="cost-amount">Costo de compra (Bs)</label>
              <input
                id="cost-amount"
                name="amount"
                type="number"
                min="0"
                step="0.01"
                required
                autocomplete="off"
              />
            </div>
            <div class="adm-field">
              <label for="cost-valid-from">Vigente desde</label>
              <input id="cost-valid-from" name="validFrom" type="date" value={isoToday()} required />
            </div>
            <div class="adm-actions">
              <button class="adm-btn" type="submit">Registrar costo</button>
            </div>
          </form>
        </section>

        <section class="adm-card" aria-labelledby="margenes-title">
          <div class="adm-card-head">
            <h2 id="margenes-title">Márgenes de {selectedBranch?.name}</h2>
            <span class="adm-chip">{margins.length} con costo</span>
          </div>

          <div class="adm-table-wrap">
            <table class="adm-table adm-table--cards">
              <thead>
                <tr>
                  <th scope="col">Producto</th>
                  <th scope="col">Precio de venta</th>
                  <th scope="col">Costo</th>
                  <th scope="col">Margen</th>
                  <th scope="col">Margen %</th>
                </tr>
              </thead>
              <tbody>
                {rows.map(({ product, margin }) => (
                  <tr>
                    <td data-label="Producto">
                      <strong>{product.name}</strong>
                      <div class="adm-cell-muted">
                        {product.sku} · {unitLabels[product.unit] ?? product.unit}
                      </div>
                    </td>
                    <td data-label="Precio" class="adm-num">{formatMoney(product.unitPrice)}</td>
                    <td data-label="Costo" class="adm-num">
                      {margin === null ? (
                        <span class="adm-chip">Sin costo</span>
                      ) : (
                        formatMoney(margin.costPrice)
                      )}
                    </td>
                    <td data-label="Margen" class={`adm-num ${margin !== null && margin.marginAmount < 0 ? 'adm-negative' : ''}`}>
                      {margin === null ? '—' : formatMoney(margin.marginAmount)}
                    </td>
                    <td data-label="Margen %" class="adm-num">
                      {margin?.marginPercent === null || margin?.marginPercent === undefined
                        ? '—'
                        : `${margin.marginPercent.toFixed(1)} %`}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <p class="adm-note">
            Solo los productos con costo vigente muestran margen. Un costo nuevo debe empezar
            después del último vigente para no solaparse.
          </p>
        </section>
      </>
    )
  }
</AdminShell>
