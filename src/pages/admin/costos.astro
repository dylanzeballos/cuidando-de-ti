---
import AdminShell from '@/components/admin/admin-shell.astro';
import LoadingState from '@/components/primitives/loading-state.astro';
import EmptyState from '@/components/primitives/empty-state.astro';
import ErrorState from '@/components/primitives/error-state.astro';
import { API_BASE_URL } from 'astro:env/server';
import { createAdminClient, type Branch, type Product } from '@/lib/admin/catalog-api';
import { resolveCostsClient } from '@/lib/admin/costs-service';
import { latestCost, marginOf, type CostEntry } from '@/lib/admin/costs-api';
import { COST_FIELD_ERRORS, validateCostInput } from '@/lib/admin/costs-validation';
import { formatMoney } from '@/lib/sales/cart';
import { INSTALLATION } from '@/lib/installation';

// El token viene de la sesión de servidor; el navegador nunca lo recibe. La
// empresa es implícita de la instalación: no se lee de `query` ni de `body`. El
// middleware ya garantiza la sesión para `/admin/**`.
const auth = await Astro.session?.get('auth');
if (!auth) {
  return Astro.redirect('/entrar?redirect=%2Fadmin%2Fcostos', 303);
}

const empresa = Astro.locals.empresa;
const empresaName = INSTALLATION.name;

const catalog = createAdminClient({ baseUrl: API_BASE_URL, token: auth.accessToken });
const costs = resolveCostsClient(auth.accessToken, empresaName);

const back = (params: Record<string, string>) =>
  new Response(null, {
    status: 303,
    headers: { location: `/admin/costos?${new URLSearchParams(params).toString()}` },
  });

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  if (action !== 'cost') return back({ error: 'Acción no reconocida.' });

  const productId = String(form.get('productId') ?? '').trim();
  const branchId = String(form.get('branchId') ?? '').trim();
  const amountRaw = String(form.get('amount') ?? '');
  const validFrom = String(form.get('validFrom') ?? '').trim();

  // Validación en servidor antes de llamar a la API: un costo inválido no se envía.
  const fieldError = validateCostInput({ productId, branchId, amountRaw });
  if (fieldError !== null) return back({ form: 'cost', error: fieldError, productId, branchId });

  const result = await costs.recordCost({
    productId,
    branchId,
    amount: Number(amountRaw),
    ...(validFrom.length > 0 ? { validFrom } : {}),
  });
  if (result.status === 'ok') return back({ branchId, ok: 'Costo registrado.' });
  // Los errores del backend (producto inexistente, vigencia solapada) se muestran legibles.
  return back({ form: 'cost', error: result.message, productId, branchId });
}

let branches: Branch[] = [];
let products: Product[] = [];
let costList: CostEntry[] = [];
let loadError: string | null = null;
let costsUnavailable = false;

const [branchesResult, productsResult] = await Promise.all([
  catalog.listBranches(),
  catalog.listProducts({ active: true }),
]);
if (branchesResult.status === 'ok') branches = branchesResult.data;
else loadError = branchesResult.message;
if (productsResult.status === 'ok') products = productsResult.data.items;
else loadError ??= productsResult.message;

const queryBranchId = Astro.url.searchParams.get('branchId');
const selectedBranch = branches.find((branch) => branch.id === queryBranchId) ?? branches[0] ?? null;

// Los costos de la sucursal elegida vienen de la API; ante un fallo no se
// muestra ninguna lista con datos.
if (selectedBranch !== null && loadError === null) {
  const costsResult = await costs.listCosts({ branchId: selectedBranch.id });
  if (costsResult.status === 'ok') costList = costsResult.data;
  else {
    costsUnavailable = costsResult.status === 'unavailable';
    loadError = costsResult.message;
  }
}

const okMessage = Astro.url.searchParams.get('ok');
const errorMessage = Astro.url.searchParams.get('error');
const isFieldError =
  Astro.url.searchParams.get('form') === 'cost' &&
  errorMessage !== null &&
  COST_FIELD_ERRORS.has(errorMessage);
const pageError = errorMessage !== null && !isFieldError ? errorMessage : null;

const COST_FIELD_ERROR_TEXT: Record<string, string> = {
  'product-required': 'Elige el producto del costo.',
  'branch-required': 'Elige la sucursal del costo.',
  'amount-required': 'Escribe el costo de compra.',
  'amount-invalid': 'El costo debe ser un número.',
  'amount-negative': 'El costo debe ser un número mayor o igual a cero.',
};
const fieldError = isFieldError && errorMessage !== null ? (COST_FIELD_ERROR_TEXT[errorMessage] ?? 'Revisa este campo.') : null;
const submittedProductId = Astro.url.searchParams.get('productId') ?? '';
const submittedBranchId = Astro.url.searchParams.get('branchId') ?? selectedBranch?.id ?? '';

// El margen se calcula en el servidor a partir del precio de venta vigente y del
// costo más reciente de la sucursal: el HTML servido ya lo muestra.
type CostRow = {
  product: Product;
  cost: CostEntry | null;
  margin: number | null;
};
const rows: CostRow[] =
  selectedBranch === null
    ? []
    : products.map((product) => {
        const cost = latestCost(costList, product.id, selectedBranch.id);
        return { product, cost, margin: cost === null ? null : marginOf(product.unitPrice, cost.amount) };
      });

// El middleware adjunta la empresa desde el servidor; `null` solo mientras se resuelve.
const status = empresa === null ? 'loading' : empresa.status;
---

<AdminShell title="Costos" active="/admin/costos">
  <header class="adm-page-head">
    <h1>Costos</h1>
    <p class="adm-sub">
      Costo de compra y margen por producto y sucursal de {empresaName}. Registra
      también los <a href="/admin/gastos">gastos operativos</a> por periodo.
    </p>
  </header>

  {okMessage && <p class="adm-banner adm-banner--ok" role="status">{okMessage}</p>}
  {pageError && <p class="adm-banner adm-banner--error" role="alert">{pageError}</p>}

  {
    status === 'loading' ? (
      <LoadingState label="Cargando la configuración de la empresa…" />
    ) : status === 'unavailable' ? (
      <ErrorState message="No pudimos cargar la configuración de la empresa. Inténtalo de nuevo en unos minutos." />
    ) : loadError !== null ? (
      <ErrorState
        title={costsUnavailable ? 'La API de costos no está disponible' : 'No se pudo cargar'}
        message="No pudimos cargar los costos de la empresa. Inténtalo de nuevo en unos minutos."
      />
    ) : branches.length === 0 ? (
      <EmptyState
        title="Aún no hay sucursales"
        message="Crea una sucursal en el inventario para poder registrar el costo por sucursal."
      >
        <a class="adm-btn" href="/admin/inventario" style="align-self: flex-start; text-decoration: none;">
          Ir al inventario
        </a>
      </EmptyState>
    ) : products.length === 0 ? (
      <EmptyState
        title="Aún no hay productos"
        message="Registra productos en el catálogo para poder fijar su costo de compra."
      >
        <a class="adm-btn" href="/admin/catalogo" style="align-self: flex-start; text-decoration: none;">
          Ir al catálogo
        </a>
      </EmptyState>
    ) : (
      <>
        <section class="adm-card" aria-labelledby="sucursal-title">
          <div class="adm-card-head">
            <h2 id="sucursal-title">Sucursal</h2>
            <span class="adm-chip">{branches.length}</span>
          </div>
          <ul class="adm-list" role="list">
            {branches.map((branch) => (
              <li>
                <a href={`/admin/costos?branchId=${encodeURIComponent(branch.id)}`}>
                  <span class={`adm-chip${selectedBranch?.id === branch.id ? ' adm-chip--on' : ''}`}>
                    {branch.code} · {branch.name}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section class="adm-card" aria-labelledby="registrar-title">
          <div class="adm-card-head">
            <h2 id="registrar-title">Registrar costo</h2>
          </div>

          <form class="adm-form" method="post" aria-describedby={fieldError ? 'cost-error' : undefined}>
            <input type="hidden" name="action" value="cost" />
            <div class="adm-field">
              <label for="cost-product">Producto</label>
              <select
                id="cost-product"
                name="productId"
                required
                aria-invalid={errorMessage === 'product-required'}
                aria-describedby={fieldError ? 'cost-error' : undefined}
              >
                <option value="">Elige un producto</option>
                {products.map((product) => (
                  <option value={product.id} selected={product.id === submittedProductId}>
                    {product.sku} · {product.name}
                  </option>
                ))}
              </select>
            </div>
            <div class="adm-field">
              <label for="cost-branch">Sucursal</label>
              <select
                id="cost-branch"
                name="branchId"
                required
                aria-invalid={errorMessage === 'branch-required'}
                aria-describedby={fieldError ? 'cost-error' : undefined}
              >
                {branches.map((branch) => (
                  <option value={branch.id} selected={branch.id === submittedBranchId}>
                    {branch.code} · {branch.name}
                  </option>
                ))}
              </select>
            </div>
            <div class="adm-field">
              <label for="cost-amount">Costo de compra (Bs)</label>
              <input
                id="cost-amount"
                name="amount"
                type="number"
                min="0"
                step="0.01"
                required
                autocomplete="off"
                aria-invalid={errorMessage === 'amount-negative' || errorMessage === 'amount-invalid' || errorMessage === 'amount-required'}
                aria-describedby={fieldError ? 'cost-error' : undefined}
              />
            </div>
            <div class="adm-field">
              <label for="cost-valid-from">Vigente desde</label>
              <input id="cost-valid-from" name="validFrom" type="date" autocomplete="off" aria-describedby={fieldError ? 'cost-error' : undefined} />
            </div>
            <div class="adm-actions">
              <button class="adm-btn" type="submit">Registrar costo</button>
            </div>
          </form>
          {fieldError && (
            <p id="cost-error" class="adm-field-error" role="alert">{fieldError}</p>
          )}
        </section>

        <section class="adm-card" aria-labelledby="lista-title">
          <div class="adm-card-head">
            <h2 id="lista-title">Productos y margen · {selectedBranch?.name}</h2>
            <span class="adm-chip">{rows.length}</span>
          </div>

          <div class="adm-table-wrap">
            <table class="adm-table">
              <thead>
                <tr>
                  <th scope="col">Producto</th>
                  <th scope="col">Precio de venta</th>
                  <th scope="col">Costo de compra</th>
                  <th scope="col">Margen</th>
                  <th scope="col">Vigencia</th>
                </tr>
              </thead>
              <tbody>
                {rows.map(({ product, cost, margin }) => (
                  <tr>
                    <td>
                      <strong>{product.name}</strong>
                      <br />
                      <span class="adm-sub">{product.sku}</span>
                    </td>
                    <td class="adm-num">{formatMoney(product.unitPrice)}</td>
                    <td class="adm-num">
                      {cost === null ? (
                        <span class="adm-chip">Sin costo registrado</span>
                      ) : (
                        formatMoney(cost.amount)
                      )}
                    </td>
                    <td class="adm-num">
                      {margin === null ? (
                        <span class="adm-sub">Sin costo</span>
                      ) : margin < 0 ? (
                        <span class="adm-badge adm-badge--off">Margen negativo: {formatMoney(margin)}</span>
                      ) : margin === 0 ? (
                        <span class="adm-chip">Margen cero: {formatMoney(margin)}</span>
                      ) : (
                        formatMoney(margin)
                      )}
                    </td>
                    <td>
                      {cost === null ? (
                        <span class="adm-sub">—</span>
                      ) : cost.validTo === null ? (
                        <span class="adm-sub">Desde {cost.validFrom} · vigente</span>
                      ) : (
                        <span class="adm-sub">{cost.validFrom} – {cost.validTo}</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      </>
    )
  }
</AdminShell>
