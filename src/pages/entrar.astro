---
import BaseLayout from '@/layouts/base-layout.astro';
import Container from '@/components/primitives/container.astro';
import Panel from '@/components/primitives/panel.astro';
import BrandLogo from '@/components/brand-logo.astro';
import { INSTALLATION } from '@/lib/installation';

const params = Astro.url.searchParams;
const error = params.get('error');
const email = params.get('email') ?? '';
const redirect = params.get('redirect') ?? '/admin';

const messages: Record<string, string> = {
  email: 'Escribe un correo válido.',
  password: 'Escribe tu contraseña.',
  invalid: 'Correo o contraseña incorrectos.',
  unavailable: 'El servicio de inicio de sesión no está disponible por ahora. Inténtalo más tarde.',
};
const message = error ? (messages[error] ?? 'No se pudo iniciar sesión.') : null;
const fieldError = error === 'email' || error === 'password' ? error : null;
---

<BaseLayout title="Iniciar sesión" noindex>
  <main class="entrar">
    <Container class="entrar-inner">
      <Panel class="entrar-card">
        <div class="entrar-brand">
          <BrandLogo size={44} />
          <span class="entrar-brand-text">
            <strong>{INSTALLATION.name}</strong>
            <small>{INSTALLATION.sector}</small>
          </span>
        </div>
        <h1 class="entrar-title">Iniciar sesión</h1>
        <p class="entrar-sub">Accede a la administración de {INSTALLATION.name}.</p>

        {message && <p class="entrar-alert" role="alert">{message}</p>}

        <form class="entrar-form" method="post" action="/api/auth/login">
          <input type="hidden" name="redirect" value={redirect} />

          <div class="entrar-field">
            <label for="email">Correo electrónico</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="username"
              value={email}
              aria-invalid={fieldError === 'email' ? 'true' : undefined}
              aria-describedby={fieldError === 'email' ? 'email-error' : undefined}
            />
            {fieldError === 'email' && (
              <p id="email-error" class="entrar-field-error">Escribe un correo válido.</p>
            )}
          </div>

          <div class="entrar-field">
            <label for="password">Contraseña</label>
            <input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              aria-invalid={fieldError === 'password' ? 'true' : undefined}
              aria-describedby={fieldError === 'password' ? 'password-error' : undefined}
            />
            {fieldError === 'password' && (
              <p id="password-error" class="entrar-field-error">Escribe tu contraseña.</p>
            )}
          </div>

          <button class="entrar-submit" type="submit">Entrar</button>
        </form>
      </Panel>
    </Container>
  </main>
</BaseLayout>
<style>
  .entrar {
    display: grid;
    place-items: center;
    min-height: 100vh;
    padding: 1.5rem;
    background: color-mix(in srgb, var(--empresa-foreground) 5%, var(--empresa-background));
  }
  .entrar-inner {
    max-width: 26rem;
  }
  .entrar-card {
    padding: 2rem;
  }
  .entrar-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.35rem;
  }
  .entrar-brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .entrar-brand-text strong {
    font-size: 1rem;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }
  .entrar-brand-text small {
    color: var(--muted-foreground);
    font-size: 0.78rem;
  }
  .entrar-title {
    margin: 0;
    font-size: 1.6rem;
    letter-spacing: -0.03em;
  }
  .entrar-sub {
    margin: 0.35rem 0 1.25rem;
    color: var(--muted-foreground);
  }
  .entrar-alert {
    margin: 0 0 1.25rem;
    padding: 0.7rem 0.9rem;
    border-radius: 10px;
    background: color-mix(in srgb, var(--destructive) 12%, transparent);
    color: var(--destructive);
    font-weight: 550;
  }
  .entrar-form {
    display: grid;
    gap: 1rem;
  }
  .entrar-field {
    display: grid;
    gap: 0.3rem;
  }
  .entrar-field label {
    font-size: 0.8rem;
    font-weight: 650;
    color: var(--muted-foreground);
  }
  .entrar-field input {
    width: 100%;
    padding: 0.6rem 0.7rem;
    font: inherit;
    color: var(--foreground);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  .entrar-field input:focus-visible {
    outline: 2px solid var(--empresa-primary);
    outline-offset: 2px;
  }
  .entrar-field input[aria-invalid="true"] {
    border-color: var(--destructive);
  }
  .entrar-field-error {
    margin: 0;
    color: var(--destructive);
    font-size: 0.82rem;
  }
  .entrar-submit {
    margin-top: 0.35rem;
    padding: 0.65rem 1rem;
    font: inherit;
    font-weight: 620;
    color: var(--empresa-background);
    background: var(--empresa-primary);
    border: 0;
    border-radius: 10px;
    cursor: pointer;
    transition: transform 130ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .entrar-submit:active {
    transform: scale(0.97);
  }
  .entrar-submit:focus-visible {
    outline: 2px solid var(--empresa-primary);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .entrar-submit:active {
      transform: none;
    }
  }
</style>
