---
interface Item {
  label: string;
  value: number;
  detail?: string;
}

interface Props {
  items: Item[];
  kind?: 'money' | 'number' | 'percent';
  colors?: boolean;
  label?: string;
}

const { items, kind = 'money', colors = false, label = 'Ranking' } = Astro.props;

const max = Math.max(...items.map((item) => item.value), 0);
const palette = ['var(--rep-c1)', 'var(--rep-c2)', 'var(--rep-c3)', 'var(--rep-c4)', 'var(--rep-c5)'];

function formatValue(value: number): string {
  if (kind === 'percent') return `${value.toFixed(1)} %`;
  if (kind === 'number') return new Intl.NumberFormat('es-BO').format(value);
  return `Bs ${value.toFixed(2)}`;
}
---

<ul class="rep-bars" aria-label={label}>
  {items.map((item, index) => (
    <li
      class="rep-bar"
      style={colors ? `--rep-color: ${palette[index % palette.length]}` : undefined}
    >
      <span class="rep-bar-label">{item.label}</span>
      <span class="rep-bar-value">{formatValue(item.value)}</span>
      <span class="rep-bar-track" aria-hidden="true">
        <span
          class="rep-bar-fill"
          style={`width:${max > 0 ? Math.max((item.value / max) * 100, 2) : 0}%`}
        ></span>
      </span>
      {item.detail && <span class="rep-bar-detail">{item.detail}</span>}
    </li>
  ))}
</ul>
