---
interface Point {
  label: string;
  value: number;
  detail?: string;
}

interface Props {
  points: Point[];
  height?: number;
  label?: string;
}

const { points, height = 230, label = 'Ingresos por mes' } = Astro.props;

const W = 720;
const H = height;
const pad = { top: 16, right: 12, bottom: 30, left: 56 };
const innerW = W - pad.left - pad.right;
const innerH = H - pad.top - pad.bottom;

function niceMax(value: number): number {
  if (!Number.isFinite(value) || value <= 0) return 1;
  const exponent = Math.floor(Math.log10(value));
  const base = 10 ** exponent;
  const normalized = value / base;
  const step = normalized <= 1 ? 1 : normalized <= 2 ? 2 : normalized <= 5 ? 5 : 10;
  return step * base;
}

const maxValue = niceMax(Math.max(...points.map((point) => point.value), 0));
const slot = innerW / Math.max(points.length, 1);
const barWidth = Math.min(slot * 0.46, 34);
const yAt = (value: number) => pad.top + innerH - (value / maxValue) * innerH;
const ticks = 4;
const tickValues = Array.from({ length: ticks + 1 }, (_, index) => (maxValue / ticks) * index);

function compact(value: number): string {
  if (value >= 1_000_000) return `${(value / 1_000_000).toFixed(1)}M`;
  if (value >= 1_000) return `${(value / 1_000).toFixed(value >= 10_000 ? 0 : 1)}k`;
  return String(Math.round(value));
}

const summary = points.map((point) => `${point.label}: ${point.value}`).join(', ');
---

<figure class="rep-chart">
  <svg class="rep-svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${label}. ${summary}`}>
    {tickValues.map((value) => (
      <g>
        <line
          class="rep-grid-line"
          x1={pad.left}
          x2={W - pad.right}
          y1={yAt(value)}
          y2={yAt(value)}
        />
        <text class="rep-axis" x={pad.left - 9} y={yAt(value)} text-anchor="end" dominant-baseline="middle">
          Bs {compact(value)}
        </text>
      </g>
    ))}

    {points.map((point, index) => {
      const center = pad.left + slot * index + slot / 2;
      const barHeight = Math.max(pad.top + innerH - yAt(point.value), point.value > 0 ? 2 : 0);
      return (
        <g>
          <rect
            class="rep-bar-rect"
            x={center - barWidth / 2}
            y={pad.top + innerH - barHeight}
            width={barWidth}
            height={barHeight}
            rx="5"
          >
            <title>{`${point.label}: Bs ${point.value.toFixed(2)}${point.detail ? ` · ${point.detail}` : ''}`}</title>
          </rect>
          <text class="rep-axis" x={center} y={H - 9} text-anchor="middle">
            {point.label}
          </text>
        </g>
      );
    })}
  </svg>
</figure>
