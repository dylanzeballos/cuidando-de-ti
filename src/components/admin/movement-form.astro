---
import type { Branch, Product } from '@/lib/admin/catalog-api';

interface Props {
  branches: Branch[];
  products: Product[];
  selectedBranchId: string;
  open: boolean;
  presetProductId?: string;
  presetType?: 'ENTRY' | 'EXIT' | 'ADJUSTMENT';
}

const {
  branches,
  products,
  selectedBranchId,
  open,
  presetProductId,
  presetType = 'ENTRY',
} = Astro.props;
const type = ['ENTRY', 'EXIT', 'ADJUSTMENT'].includes(presetType) ? presetType : 'ENTRY';
const headings = {
  ENTRY: 'Registrar entrada',
  EXIT: 'Registrar salida',
  ADJUSTMENT: 'Ajustar existencias',
};
const hint = {
  ENTRY: 'La cantidad se suma a las existencias actuales.',
  EXIT: 'La cantidad se resta de las existencias actuales.',
  ADJUSTMENT: 'La cantidad reemplaza las existencias actuales.',
};
---

<dialog
  id="movement-dialog"
  class="adm-modal"
  aria-labelledby="movement-dialog-title"
  data-dialog-auto-open={open ? '' : undefined}
>
  <form method="post">
    <input type="hidden" name="action" value="movement" />

    <header class="adm-modal-head">
      <div>
        <h2 id="movement-dialog-title" data-dialog-title>{headings[type]}</h2>
        <p>Entrada, salida o ajuste de existencias.</p>
      </div>
      <button class="adm-modal-close" type="button" data-dialog-close aria-label="Cerrar">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </header>

    <div class="adm-modal-body adm-form">
      <div class="adm-field">
        <label for="movement-type">Tipo de movimiento</label>
        <select id="movement-type" name="type" required>
          <option value="ENTRY" selected={type === 'ENTRY'}>Entrada (+)</option>
          <option value="EXIT" selected={type === 'EXIT'}>Salida (−)</option>
          <option value="ADJUSTMENT" selected={type === 'ADJUSTMENT'}>Ajuste (=)</option>
        </select>
      </div>
      <div class="adm-field">
        <label for="movement-branch">Sucursal</label>
        <select id="movement-branch" name="branchId" required>
          {branches.map((branch) => (
            <option value={branch.id} selected={branch.id === selectedBranchId}>
              {branch.code} · {branch.name}
            </option>
          ))}
        </select>
      </div>
      <div class="adm-field adm-field--full">
        <label for="movement-product">Producto</label>
        <select id="movement-product" name="productId" required>
          {products.map((product) => (
            <option value={product.id} selected={product.id === presetProductId}>
              {product.sku} · {product.name}
            </option>
          ))}
        </select>
      </div>
      <div class="adm-field">
        <label for="movement-quantity">Cantidad</label>
        <input
          id="movement-quantity"
          name="quantity"
          type="number"
          min="0"
          step="1"
          inputmode="numeric"
          required
        />
        <p class="adm-field-hint" data-field-hint>{hint[type]}</p>
      </div>
      <div class="adm-field">
        <label for="movement-reason">Motivo</label>
        <input id="movement-reason" name="reason" maxlength="240" autocomplete="off" />
      </div>
    </div>

    <footer class="adm-modal-foot">
      <button class="adm-btn adm-btn--ghost" type="button" data-dialog-close>Cancelar</button>
      <button class="adm-btn" type="submit">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
        Guardar movimiento
      </button>
    </footer>
  </form>
</dialog>

<script>
  const dialog = document.getElementById('movement-dialog');
  const typeSelect = dialog?.querySelector<HTMLSelectElement>('#movement-type');
  const title = dialog?.querySelector<HTMLElement>('[data-dialog-title]');
  const hint = dialog?.querySelector<HTMLElement>('[data-field-hint]');

  const COPY: Record<string, { title: string; hint: string }> = {
    ENTRY: {
      title: 'Registrar entrada',
      hint: 'La cantidad se suma a las existencias actuales.',
    },
    EXIT: {
      title: 'Registrar salida',
      hint: 'La cantidad se resta de las existencias actuales.',
    },
    ADJUSTMENT: {
      title: 'Ajustar existencias',
      hint: 'La cantidad reemplaza las existencias actuales.',
    },
  };

  typeSelect?.addEventListener('change', () => {
    const copy = COPY[typeSelect.value] ?? COPY.ENTRY;
    if (title) title.textContent = copy.title;
    if (hint) hint.textContent = copy.hint;
  });
</script>
