---
import type { Role } from '@/lib/admin/identity-api';

interface Props {
  roles: Role[];
  permissionModules: Map<string, string>;
}

const { roles, permissionModules } = Astro.props;

const moduleNames = (role: Role): string[] => [
  ...new Set(role.permissions.map((code) => permissionModules.get(code) ?? code)),
];
---

<section class="adm-card" aria-labelledby="lista-roles-title">
  <div class="adm-card-head">
    <h2 id="lista-roles-title">Roles de la empresa</h2>
    <span class="adm-chip">{roles.length}</span>
  </div>

  <div class="adm-table-wrap">
    <table class="adm-table adm-table--cards">
      <thead>
        <tr>
          <th scope="col">Rol</th>
          <th scope="col">Módulos</th>
          <th scope="col">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {roles.map((role) => (
          <tr>
            <td data-label="Rol">
              <strong>{role.name}</strong>
              {role.description && <div class="adm-cell-muted">{role.description}</div>}
            </td>
            <td data-label="Módulos">
              {role.permissions.length === 0 ? (
                <span class="adm-chip">Sin permisos</span>
              ) : (
                <ul class="adm-list" role="list">
                  {moduleNames(role).map((name) => (
                    <li><span class="adm-chip">{name}</span></li>
                  ))}
                </ul>
              )}
            </td>
            <td data-label="Acciones">
              <div class="adm-row-actions">
                <a class="adm-btn adm-btn--small adm-btn--ghost" href={`/admin/roles?edit=${role.id}`}>
                  Editar
                </a>
                <form method="post">
                  <input type="hidden" name="action" value="delete-role" />
                  <input type="hidden" name="roleId" value={role.id} />
                  <button class="adm-btn adm-btn--small adm-btn--danger" type="submit">
                    Eliminar
                  </button>
                </form>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
