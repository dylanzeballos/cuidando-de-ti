---
import { describeModule } from '@/lib/module-catalog';
import type { PermissionGroup, Role } from '@/lib/admin/identity-api';

interface Props {
  editingRole: Role | null;
  fieldError: string | null;
  permissionsGroups: PermissionGroup[];
  hiddenPermissions: string[];
}

const { editingRole, fieldError, permissionsGroups, hiddenPermissions } = Astro.props;
const selected = new Set(editingRole?.permissions ?? []);
---

<section class="adm-card" aria-labelledby="rol-form-title">
  <div class="adm-card-head">
    <h2 id="rol-form-title">
      {editingRole ? `Editar «${editingRole.name}»` : 'Nuevo rol'}
    </h2>
    {editingRole && <a class="adm-link" href="/admin/roles">Cancelar edición</a>}
  </div>

  <form method="post">
    <input type="hidden" name="action" value="save-role" />
    <input type="hidden" name="roleId" value={editingRole?.id ?? ''} />

    <div class="adm-form">
      <div class="adm-field">
        <label for="role-name">Nombre</label>
        <input
          id="role-name"
          name="name"
          required
          maxlength="80"
          value={editingRole?.name ?? ''}
          aria-invalid={fieldError !== null}
          aria-describedby={fieldError ? 'role-name-error' : undefined}
        />
        {fieldError && <p id="role-name-error" class="adm-field-error" role="alert">{fieldError}</p>}
      </div>
      <div class="adm-field">
        <label for="role-description">Descripción</label>
        <input
          id="role-description"
          name="description"
          maxlength="240"
          value={editingRole?.description ?? ''}
        />
      </div>
    </div>

    {hiddenPermissions.length > 0 && (
      <p class="adm-banner adm-banner--warn" role="status">
        Permisos de módulos no habilitados que no se ofrecen ni se concederán:{' '}
        {hiddenPermissions.join(', ')}.
      </p>
    )}

    <div class="adm-permissions">
      <div class="adm-permissions-head">
        <h3 id="permissions-title">Permisos por módulo</h3>
        <p>Marca lo que puede hacer este rol. Solo se ofrecen módulos habilitados.</p>
      </div>

      {permissionsGroups.length === 0 ? (
        <p class="adm-note">
          No hay módulos con permisos habilitados. Activa módulos en la configuración de la
          empresa para asignar permisos.
        </p>
      ) : (
        <ul class="adm-permission-list" aria-labelledby="permissions-title">
          {permissionsGroups.map((group) =>
            group.permissions.map((permission) => (
              <li>
                <label class="adm-permission">
                  <input
                    type="checkbox"
                    name="permissions"
                    value={permission.code}
                    checked={selected.has(permission.code)}
                  />
                  <span class="adm-permission-check" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m5 13 4 4L19 7" />
                    </svg>
                  </span>
                  <span class="adm-permission-text">
                    <strong>{describeModule(group.moduleCode).name}</strong>
                    <small>{permission.description || 'Acceso al módulo'}</small>
                  </span>
                </label>
              </li>
            )),
          )}
        </ul>
      )}
    </div>

    <div class="adm-actions">
      <button class="adm-btn" type="submit">{editingRole ? 'Guardar rol' : 'Crear rol'}</button>
    </div>
  </form>
</section>
