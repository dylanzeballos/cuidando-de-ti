---
import type { Category } from '@/lib/admin/catalog-api';

interface Props {
  categories: Category[];
  open: boolean;
}

const { categories, open } = Astro.props;
---

<details class="adm-card adm-details" open={open}>
  <summary class="adm-details-summary">
    <span>
      <strong>Nuevo producto</strong>
      <small>SKU, precio, impuesto y categoría</small>
    </span>
    <span class="adm-chip">Crear</span>
  </summary>

  <form class="adm-form" method="post">
    <input type="hidden" name="action" value="product" />

    <div class="adm-field">
      <label for="sku">SKU</label>
      <input id="sku" name="sku" required maxlength="64" placeholder="PARA-500" autocomplete="off" />
    </div>
    <div class="adm-field">
      <label for="name">Nombre</label>
      <input
        id="name"
        name="name"
        required
        maxlength="200"
        placeholder="Paracetamol 500 mg"
        autocomplete="off"
      />
    </div>
    <div class="adm-field">
      <label for="barcode">Código de barras</label>
      <input id="barcode" name="barcode" maxlength="64" inputmode="numeric" autocomplete="off" />
    </div>
    <div class="adm-field">
      <label for="unit">Unidad</label>
      <select id="unit" name="unit" required>
        <option value="UNIT">Unidad</option>
        <option value="KG">Kilogramo</option>
        <option value="LITER">Litro</option>
        <option value="PACK">Paquete</option>
      </select>
    </div>
    <div class="adm-field">
      <label for="unitPrice">Precio (Bs)</label>
      <input id="unitPrice" name="unitPrice" type="number" min="0" step="0.01" required />
    </div>
    <div class="adm-field">
      <label for="taxRate">Impuesto (%)</label>
      <input id="taxRate" name="taxRate" type="number" min="0" max="100" step="0.01" value="13" required />
    </div>
    <div class="adm-field">
      <label for="categoryId">Categoría</label>
      <select id="categoryId" name="categoryId">
        <option value="">Sin categoría</option>
        {categories
          .filter((category) => category.active)
          .map((category) => (
            <option value={category.id}>{category.name}</option>
          ))}
      </select>
    </div>
    <div class="adm-actions">
      <button class="adm-btn" type="submit">Crear producto</button>
    </div>
  </form>
</details>
