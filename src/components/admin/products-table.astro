---
import type { Category, Product } from '@/lib/admin/catalog-api';
import { formatMoney } from '@/lib/sales/cart';
import ProductEditDialog from '@/components/admin/product-edit-dialog.astro';

interface Props {
  products: Product[];
  categories: Category[];
  /** Producto cuyo diálogo de edición debe abrirse al cargar (tras un error). */
  openProductId?: string;
}

const { products, categories, openProductId } = Astro.props;
const categoryName = new Map(categories.map((category) => [category.id, category.name]));

const unitLabels: Record<string, string> = {
  UNIT: 'Unidad',
  KG: 'Kilogramo',
  LITER: 'Litro',
  PACK: 'Paquete',
};
---

<div class="adm-table-wrap">
  <table class="adm-table adm-table--cards">
    <thead>
      <tr>
        <th scope="col">Producto</th>
        <th scope="col">Categoría</th>
        <th scope="col">Precio</th>
        <th scope="col">Impuesto</th>
        <th scope="col">Estado</th>
        <th scope="col" class="adm-col-actions">Acciones</th>
      </tr>
    </thead>
    <tbody>
      {products.map((product) => {
        const dialogId = `product-${product.id}`;
        return (
          <tr>
            <td data-label="Producto">
              <strong>{product.name}</strong>
              <div class="adm-cell-muted">
                {product.sku} · {unitLabels[product.unit] ?? product.unit}
              </div>
            </td>
            <td data-label="Categoría">
              {product.categoryId === null
                ? '—'
                : (categoryName.get(product.categoryId) ?? '—')}
            </td>
            <td data-label="Precio" class="adm-num">{formatMoney(product.unitPrice)}</td>
            <td data-label="Impuesto" class="adm-num">{product.taxRate.toFixed(1)} %</td>
            <td data-label="Estado">
              <span class={`adm-badge ${product.active ? 'adm-badge--on' : 'adm-badge--off'}`}>
                {product.active ? 'Activo' : 'Inactivo'}
              </span>
            </td>
            <td data-label="Acciones" class="adm-col-actions">
              <div class="adm-row-actions">
                <button
                  class="adm-btn adm-btn--small adm-btn--ghost"
                  type="button"
                  data-dialog-target={dialogId}
                >
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.9"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
                  </svg>
                  Editar
                </button>
                <form method="post">
                  <input type="hidden" name="action" value="product-status" />
                  <input type="hidden" name="productId" value={product.id} />
                  <input type="hidden" name="active" value={product.active ? 'false' : 'true'} />
                  <button
                    class={`adm-btn adm-btn--small ${product.active ? 'adm-btn--ghost' : ''}`}
                    type="submit"
                    data-confirm={
                      product.active
                        ? `¿Desactivar “${product.name}”? Dejará de estar disponible para la venta.`
                        : undefined
                    }
                  >
                    {product.active ? 'Desactivar' : 'Activar'}
                  </button>
                </form>
              </div>
              <ProductEditDialog
                product={product}
                categories={categories}
                open={openProductId === product.id}
              />
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
