---
import type { CostRow } from '@/lib/admin/costs-ui';
import { formatMoney } from '@/lib/sales/cart';

interface Props {
  rows: CostRow[];
  branchId: string;
  unitLabels: Record<string, string>;
}

const { rows, branchId, unitLabels } = Astro.props;
---

<div class="adm-table-wrap">
  <table class="adm-table adm-table--cards">
    <thead>
      <tr>
        <th scope="col">Producto</th>
        <th scope="col">Precio de venta</th>
        <th scope="col">Costo</th>
        <th scope="col">Margen</th>
        <th scope="col">Margen %</th>
        <th scope="col" class="adm-col-actions">Acciones</th>
      </tr>
    </thead>
    <tbody>
      {rows.map(({ product, margin }) => (
        <tr>
          <td data-label="Producto">
            <strong>{product.name}</strong>
            <div class="adm-cell-muted">
              {product.sku} · {unitLabels[product.unit] ?? product.unit}
            </div>
          </td>
          <td data-label="Precio" class="adm-num">{formatMoney(product.unitPrice)}</td>
          <td data-label="Costo" class="adm-num">
            {margin === null ? (
              <span class="adm-chip">Sin costo</span>
            ) : (
              formatMoney(margin.costPrice)
            )}
          </td>
          <td
            data-label="Margen"
            class={`adm-num ${margin !== null && margin.marginAmount < 0 ? 'adm-negative' : ''}`}
          >
            {margin === null ? '—' : formatMoney(margin.marginAmount)}
          </td>
          <td data-label="Margen %" class="adm-num">
            {margin?.marginPercent === null || margin?.marginPercent === undefined
              ? '—'
              : `${margin.marginPercent.toFixed(1)} %`}
          </td>
          <td data-label="Acciones" class="adm-col-actions">
            <div class="adm-row-actions">
              <button
                class={`adm-icon-btn${margin === null ? ' adm-icon-btn--add' : ''}`}
                type="button"
                data-dialog-target="cost-dialog"
                data-dialog-set={JSON.stringify({ productId: product.id, branchId })}
                data-dialog-heading={margin === null ? undefined : 'Actualizar costo'}
                title={margin === null ? 'Registrar costo' : 'Editar costo'}
                aria-label={
                  margin === null
                    ? `Registrar costo de ${product.name}`
                    : `Editar costo de ${product.name}`
                }
              >
                {margin === null ? (
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    aria-hidden="true"
                  >
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                ) : (
                  <svg
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.9"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
                  </svg>
                )}
              </button>
            </div>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
