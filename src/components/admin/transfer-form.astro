---
import type { Branch, Product } from '@/lib/admin/catalog-api';

interface Props {
  branches: Branch[];
  products: Product[];
  selectedBranchId: string;
  open: boolean;
}

const { branches, products, selectedBranchId, open } = Astro.props;
const fallbackDestination = branches.find((branch) => branch.id !== selectedBranchId)?.id ?? '';
const canTransfer = branches.length >= 2;
---

<dialog
  id="transfer-dialog"
  class="adm-modal"
  aria-labelledby="transfer-dialog-title"
  data-dialog-auto-open={open ? '' : undefined}
>
  {canTransfer ? (
    <form method="post">
      <input type="hidden" name="action" value="transfer" />

      <header class="adm-modal-head">
        <div>
          <h2 id="transfer-dialog-title">Transferir existencias</h2>
          <p>Mueve stock entre sucursales de la empresa.</p>
        </div>
        <button class="adm-modal-close" type="button" data-dialog-close aria-label="Cerrar">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
      </header>

      <div class="adm-modal-body adm-form">
        <div class="adm-field">
          <label for="transfer-from">Desde</label>
          <select id="transfer-from" name="fromBranchId" required>
            {branches.map((branch) => (
              <option value={branch.id} selected={branch.id === selectedBranchId}>
                {branch.code} · {branch.name}
              </option>
            ))}
          </select>
        </div>
        <div class="adm-field">
          <label for="transfer-to">Hacia</label>
          <select id="transfer-to" name="toBranchId" required>
            {branches.map((branch) => (
              <option value={branch.id} selected={branch.id === fallbackDestination}>
                {branch.code} · {branch.name}
              </option>
            ))}
          </select>
        </div>
        <div class="adm-field adm-field--full">
          <label for="transfer-product">Producto</label>
          <select id="transfer-product" name="productId" required>
            {products.map((product) => (
              <option value={product.id}>
                {product.sku} · {product.name}
              </option>
            ))}
          </select>
        </div>
        <div class="adm-field">
          <label for="transfer-quantity">Cantidad</label>
          <input
            id="transfer-quantity"
            name="quantity"
            type="number"
            min="1"
            step="1"
            inputmode="numeric"
            required
          />
          <p class="adm-field-hint">El origen y el destino deben ser distintos.</p>
        </div>
      </div>

      <footer class="adm-modal-foot">
        <button class="adm-btn adm-btn--ghost" type="button" data-dialog-close>Cancelar</button>
        <button class="adm-btn" type="submit">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 7h13m0 0-3-3m3 3-3 3M20 17H7m0 0 3-3m-3 3 3 3" />
          </svg>
          Transferir
        </button>
      </footer>
    </form>
  ) : (
    <div class="adm-modal-body">
      <p class="adm-note">
        Necesitas al menos dos sucursales para transferir existencias. Crea otra sucursal primero.
      </p>
      <div class="adm-modal-foot">
        <button class="adm-btn adm-btn--ghost" type="button" data-dialog-close>Cerrar</button>
      </div>
    </div>
  )}
</dialog>
