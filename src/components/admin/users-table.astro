---
import type { Role, UserAccount } from '@/lib/admin/identity-api';
import UserRolesDialog from '@/components/admin/user-roles-dialog.astro';

interface Props {
  users: UserAccount[];
  roles: Role[];
}

const { users, roles } = Astro.props;

const initials = (name: string): string =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part.charAt(0).toUpperCase())
    .join('');
---

<section class="adm-card" aria-labelledby="lista-usuarios-title">
  <div class="adm-card-head">
    <h2 id="lista-usuarios-title">Usuarios de la empresa</h2>
    <span class="adm-chip">{users.length} listados</span>
  </div>

  <div class="adm-table-wrap">
    <table class="adm-table adm-table--cards">
      <thead>
        <tr>
          <th scope="col">Usuario</th>
          <th scope="col">Estado</th>
          <th scope="col">Roles</th>
          <th scope="col">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {users.map((user) => (
          <tr>
            <td data-label="Usuario">
              <div class="adm-user-cell">
                <span class="adm-avatar" aria-hidden="true">{initials(user.displayName)}</span>
                <span class="adm-user-name">
                  <strong>{user.displayName}</strong>
                  <small>{user.email}</small>
                </span>
              </div>
            </td>
            <td data-label="Estado">
              <span class={`adm-badge ${user.active ? 'adm-badge--on' : 'adm-badge--off'}`}>
                {user.active ? 'Activo' : 'Inactivo'}
              </span>
            </td>
            <td data-label="Roles">
              {user.roles.length === 0 ? (
                <span class="adm-chip">Sin rol</span>
              ) : (
                <ul class="adm-list" role="list">
                  {user.roles.map((roleName) => (
                    <li><span class="adm-chip">{roleName}</span></li>
                  ))}
                </ul>
              )}
            </td>
            <td data-label="Acciones">
              <div class="adm-row-actions">
                <form method="post">
                  <input type="hidden" name="action" value="status" />
                  <input type="hidden" name="userId" value={user.id} />
                  <input type="hidden" name="active" value={user.active ? 'false' : 'true'} />
                  <button
                    class={`adm-btn adm-btn--small ${user.active ? 'adm-btn--ghost' : ''}`}
                    type="submit"
                  >
                    {user.active ? 'Desactivar' : 'Activar'}
                  </button>
                </form>

                {roles.length > 0 && (
                  <>
                    <button
                      class="adm-btn adm-btn--small adm-btn--ghost"
                      type="button"
                      data-role-dialog={`roles-${user.id}`}
                    >
                      Editar roles
                    </button>
                    <UserRolesDialog user={user} roles={roles} />
                  </>
                )}
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
