---
import '@/styles/admin.css';
import BaseLayout from '@/layouts/base-layout.astro';
import BrandLogo from '@/components/brand-logo.astro';
import ModuleIcon from '@/components/module-icon.astro';
import { buildModuleViews, groupModuleViews } from '@/lib/module-catalog';
import { getWorkspace } from '@/lib/workspaces';
import { INSTALLATION } from '@/lib/installation';

interface Props {
  title: string;
  /** Códigos de módulos habilitados de la empresa. */
  modules?: string[];
  accountEmail?: string | null;
  /** Ruta de la sección activa, por ejemplo `/admin/catalogo`. */
  active?: string;
}

const {
  title,
  active,
  modules = Astro.locals.empresa?.modules ?? [],
  accountEmail = Astro.locals.account?.email ?? null,
} = Astro.props;

const workspace = getWorkspace(Astro.locals.workspace);
// El espacio lo define el tipo de usuario (middleware/sesión). Hasta que el
// backend publique los roles, `Astro.locals.workspace` es nulo y la instalación
// opera con la vista completa; el modelo ya filtra por módulos.
const allViews = buildModuleViews(modules);
const allowedModules = workspace.modules === null ? null : new Set(workspace.modules);
const views = allowedModules === null
  ? allViews
  : allViews.filter((view) => allowedModules.has(view.code));
const groups = groupModuleViews(views);

// La sección activa es la del módulo dueño de la ruta: las subpáginas (caja,
// gastos, roles, historial) comparten la del módulo para no perder el contexto.
const currentRoute = active ?? '';
const isActive = (route: string) => currentRoute === route || currentRoute.startsWith(`${route}/`);
const isHome = currentRoute === '/admin' || currentRoute.length === 0;
const pathname = Astro.url.pathname;

// Subnavegación contextual del módulo. No repite el sidebar: son las vistas
// internas de la sección activa o anclas a los bloques de la propia página.
type HeaderTab = { label: string; href: string; anchor?: boolean };

const HEADER_TABS: Record<string, HeaderTab[]> = {
  '/admin': [
    { label: 'Resumen', href: '#dash-activity', anchor: true },
    { label: 'Cobros', href: '#dash-payments', anchor: true },
    { label: 'Productos', href: '#dash-top', anchor: true },
    { label: 'Existencias', href: '#dash-stock', anchor: true },
  ],
  '/admin/reportes': [
    { label: 'Ingresos', href: '#rep-trend', anchor: true },
    { label: 'Cobros', href: '#rep-payments', anchor: true },
    { label: 'Productos', href: '#rep-top', anchor: true },
    { label: 'Márgenes', href: '#rep-margins', anchor: true },
  ],
  '/admin/ventas': [
    { label: 'Registro', href: '/admin/ventas' },
    { label: 'Historial', href: '/admin/ventas/historial' },
    { label: 'Caja', href: '/admin/caja' },
  ],
  '/admin/catalogo': [
    { label: 'Categorías', href: '#categorias-title', anchor: true },
    { label: 'Productos', href: '#productos-title', anchor: true },
  ],
  '/admin/inventario': [
    { label: 'Sucursales', href: '#sucursales-title', anchor: true },
    { label: 'Movimientos', href: '#movimiento-title', anchor: true },
    { label: 'Existencias', href: '#stock-title', anchor: true },
  ],
  '/admin/costos': [
    { label: 'Costos', href: '/admin/costos' },
    { label: 'Gastos', href: '/admin/gastos' },
  ],
  '/admin/usuarios': [
    { label: 'Usuarios', href: '/admin/usuarios' },
    { label: 'Roles', href: '/admin/roles' },
  ],
};

const tabs = HEADER_TABS[currentRoute] ?? [];
const linkTabs = tabs.filter((tab) => tab.anchor !== true);
const activeLink = [...linkTabs]
  .sort((a, b) => b.href.length - a.href.length)
  .find((tab) => pathname === tab.href || pathname.startsWith(`${tab.href}/`))?.href;
const headerTabs = tabs.map((tab, index) => ({
  ...tab,
  current: tab.anchor === true ? index === 0 : tab.href === activeLink,
}));

const documentTitle = `${title} · ${INSTALLATION.name}`;
const accountName = (accountEmail ?? '').split('@')[0] ?? '';
const displayName = accountName.length > 0
  ? accountName.charAt(0).toUpperCase() + accountName.slice(1)
  : 'equipo';
const hour = new Date().getHours();
const greeting = hour < 12 ? 'Buen día' : hour < 19 ? 'Buenas tardes' : 'Buenas noches';
const today = new Intl.DateTimeFormat('es-BO', {
  weekday: 'short',
  day: 'numeric',
  month: 'short',
}).format(new Date());
---

<BaseLayout title={documentTitle} noindex>
  <a class="adm-skip" href="#contenido">Saltar al contenido</a>
  <div class="adm-shell" id="adm-shell">
    <aside class="adm-sidebar" id="adm-sidebar">
      <header class="adm-brand">
        <BrandLogo size={34} />
        <span class="adm-brand-text">
          <strong>{INSTALLATION.name}</strong>
          <small>{INSTALLATION.sector}</small>
        </span>
        <button
          class="adm-rail-toggle"
          type="button"
          aria-label="Contraer menú"
          aria-expanded="true"
          title="Contraer menú"
          data-adm-collapse
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6"></path>
          </svg>
        </button>
      </header>

      <nav class="adm-nav" aria-label="Secciones">
        <a
          href={workspace.landing}
          class="adm-nav-link adm-nav-home"
          title="Inicio"
          aria-current={isHome ? 'page' : undefined}
        >
          <ModuleIcon name="home" size={22} class="adm-nav-icon" />
          <span class="adm-nav-text">Inicio</span>
        </a>

        {
          groups.length === 0 ? (
            <p class="adm-nav-empty">No hay módulos habilitados.</p>
          ) : (
            groups.map((group) => (
              <details class="adm-nav-group" data-group={group.id} open>
                <summary class="adm-nav-group-label">
                  <span>{group.label}</span>
                  <svg
                    class="adm-nav-chevron"
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m6 9 6 6 6-6"></path>
                  </svg>
                </summary>
                <div class="adm-nav-items">
                  {group.views.map((view) =>
                    view.route ? (
                      <a
                        href={view.route}
                        class="adm-nav-link"
                        title={view.name}
                        aria-current={isActive(view.route) ? 'page' : undefined}
                      >
                        <ModuleIcon name={view.icon} size={22} class="adm-nav-icon" />
                        <span class="adm-nav-text">{view.name}</span>
                        {view.code === 'reports' && <span class="adm-nav-dot" aria-hidden="true" />}
                      </a>
                    ) : (
                      <span class="adm-nav-item" title={view.name}>
                        <ModuleIcon name={view.icon} size={22} class="adm-nav-icon" />
                        <span class="adm-nav-text">{view.name}</span>
                        <span class="adm-nav-soon">Pronto</span>
                      </span>
                    ),
                  )}
                </div>
              </details>
            ))
          )
        }
      </nav>

      <footer class="adm-sidebar-foot">
        <a
          class="adm-gear"
          href="/admin/roles"
          title="Configuración de roles y permisos"
          aria-label="Configuración de roles y permisos"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.09a2 2 0 0 1-1-1.74v-.51a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
          <span class="adm-gear-label">Configuración</span>
        </a>
        <div class="adm-account">
          <span class="adm-account-avatar" aria-hidden="true">
            {(accountEmail ?? '?').slice(0, 1).toUpperCase()}
          </span>
          <span class="adm-account-mail" title={accountEmail ?? 'Sesión activa'}>
            {accountEmail ?? 'Sesión activa'}
          </span>
        </div>
        <form method="post" action="/api/auth/logout">
          <button class="adm-logout" type="submit" title="Cerrar sesión">
            <svg
              class="adm-logout-icon"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.9"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
              <path d="m16 17 5-5-5-5" />
              <path d="M21 12H9" />
            </svg>
            <span>Cerrar sesión</span>
          </button>
        </form>
      </footer>
    </aside>

    <div class="adm-scrim" data-adm-scrim aria-hidden="true"></div>

    <main class="adm-main" id="contenido">
      <header class="adm-header">
        <button
          class="adm-menu-toggle"
          type="button"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="adm-sidebar"
          data-adm-menu
        >
          <span class="adm-menu-line"></span>
          <span class="adm-menu-line"></span>
          <span class="adm-menu-line"></span>
        </button>
        <div class="adm-greeting-block">
          <p class="adm-greeting">{greeting}, {displayName}</p>
          <span class="adm-context">
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            {INSTALLATION.name} · {workspace.label}
          </span>
        </div>
        <div class="adm-header-actions">
          <span class="adm-date">
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.9"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="16" rx="2"></rect>
              <path d="M8 3v4M16 3v4M3 10h18"></path>
            </svg>
            {today}
          </span>
        </div>
      </header>

      {
        headerTabs.length > 0 && (
          <nav class="adm-subnav" aria-label="Secciones del módulo">
            {headerTabs.map((tab) => (
              <a href={tab.href} class="adm-tab" aria-current={tab.current ? 'page' : undefined}>
                {tab.label}
              </a>
            ))}
          </nav>
        )
      }
      <slot />
    </main>
  </div>
</BaseLayout>

<script>
  const shell = document.getElementById('adm-shell');
  if (shell) {
    const RAIL_KEY = 'cuidando:sidebar-rail';

    const applyRail = (rail: boolean) => {
      shell.classList.toggle('adm-shell--rail', rail);
      const button = shell.querySelector<HTMLButtonElement>('[data-adm-collapse]');
      if (button) {
        button.setAttribute('aria-expanded', String(!rail));
        const label = rail ? 'Expandir menú' : 'Contraer menú';
        button.setAttribute('aria-label', label);
        button.setAttribute('title', label);
      }
      if (rail) {
        shell.querySelectorAll('details.adm-nav-group').forEach((group) => {
          group.setAttribute('open', '');
        });
      }
    };

    try {
      applyRail(localStorage.getItem(RAIL_KEY) === 'rail');

      const button = shell.querySelector<HTMLButtonElement>('[data-adm-collapse]');
      button?.addEventListener('click', () => {
        const rail = !shell.classList.contains('adm-shell--rail');
        applyRail(rail);
        localStorage.setItem(RAIL_KEY, rail ? 'rail' : 'full');
      });

      const menuButton = shell.querySelector<HTMLButtonElement>('[data-adm-menu]');
      const scrim = shell.querySelector<HTMLElement>('[data-adm-scrim]');
      const sidebar = document.getElementById('adm-sidebar');
      const mobileQuery = window.matchMedia('(max-width: 1024px)');

      const closeNav = () => {
        shell.classList.remove('adm-shell--nav-open');
        menuButton?.setAttribute('aria-expanded', 'false');
        menuButton?.setAttribute('aria-label', 'Abrir menú');
        document.documentElement.classList.remove('adm-nav-locked');
      };

      const openNav = () => {
        shell.classList.add('adm-shell--nav-open');
        menuButton?.setAttribute('aria-expanded', 'true');
        menuButton?.setAttribute('aria-label', 'Cerrar menú');
        document.documentElement.classList.add('adm-nav-locked');
        window.setTimeout(() => {
          sidebar?.querySelector<HTMLElement>('.adm-nav-link')?.focus();
        }, 280);
      };

      menuButton?.addEventListener('click', () => {
        if (shell.classList.contains('adm-shell--nav-open')) closeNav();
        else openNav();
      });

      scrim?.addEventListener('click', () => {
        closeNav();
        menuButton?.focus();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && shell.classList.contains('adm-shell--nav-open')) {
          closeNav();
          menuButton?.focus();
        }
      });

      sidebar?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          if (mobileQuery.matches) closeNav();
        });
      });

      mobileQuery.addEventListener('change', () => {
        if (!mobileQuery.matches) closeNav();
      });

      const isDesktop = window.matchMedia('(min-width: 1025px)').matches;
      shell.querySelectorAll<HTMLDetailsElement>('details.adm-nav-group').forEach((group) => {
        if (isDesktop) {
          const key = `cuidando:nav:${group.dataset.group ?? ''}`;
          if (localStorage.getItem(key) === 'closed') group.open = false;
          group.addEventListener('toggle', () => {
            localStorage.setItem(key, group.open ? 'open' : 'closed');
          });
        } else {
          group.open = true;
        }
      });
    } catch {
      // Sin almacenamiento disponible: el menú funciona con los valores por defecto.
    }
  }
</script>
