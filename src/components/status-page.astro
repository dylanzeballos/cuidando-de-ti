---
interface Props {
  title: string;
  heading: string;
  message: string;
  code?: string;
}

const { title, heading, message, code = '' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <script is:inline>
      try {
        const stored = localStorage.getItem('cuidando:theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (stored === null && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      } catch {
        // Sin almacenamiento: se usa el tema claro.
      }
    </script>
  </head>
  <body>
    <main>
      <span class="mark" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 20c0-8 6-14 16-15 1 10-5 16-13 16H4z" />
          <path d="M4 20c3-4 7-7 12-9" />
        </svg>
      </span>
      {code && <p class="code">{code}</p>}
      <h1>{heading}</h1>
      <p>{message}</p>
      <a href="/admin">Ir a la administración</a>
    </main>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: #f4f7f9;
    color: #0f172a;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  main {
    max-width: 34rem;
    padding: 2rem;
    text-align: center;
    animation: rise 460ms cubic-bezier(0.23, 1, 0.32, 1) both;
  }
  .mark {
    display: inline-grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: #2196d3;
    color: #fff;
    margin-bottom: 1.25rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 10px 24px -12px rgba(26, 127, 184, 0.9);
  }
  h1 { margin: 0 0 0.75rem; font-size: clamp(1.6rem, 4vw, 2.4rem); letter-spacing: -0.04em; line-height: 1.05; }
  .code {
    margin: 0 0 0.35rem;
    color: #1a7fb8;
    font-size: clamp(2.6rem, 8vw, 4.2rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  p { margin: 0 0 1.5rem; color: #64748b; line-height: 1.6; }
  a {
    display: inline-block;
    padding: 0.55rem 1rem;
    border-radius: 10px;
    background: #e3f2fb;
    color: #12628f;
    font-weight: 600;
    text-decoration: none;
    transition: transform 130ms cubic-bezier(0.23, 1, 0.32, 1), background-color 160ms ease;
  }
  a:active { transform: scale(0.97); }
  a:focus-visible { outline: 2px solid #1a7fb8; outline-offset: 2px; }
  @media (hover: hover) and (pointer: fine) { a:hover { background: #cfe9f9; } }
  @keyframes rise {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    main { animation: none; }
    a:active { transform: none; }
  }
  :global(html.dark) body {
    background: #071522;
    color: #e8f1f8;
  }
  :global(html.dark) p {
    color: #92a8bc;
  }
  :global(html.dark) a {
    color: #7cccf2;
    background: #10304a;
  }
  :global(html.dark) .code {
    color: #7cccf2;
  }
</style>
