---
interface Props {
  label?: string;
  class?: string;
}

const { label = 'Cargando…', class: className = '' } = Astro.props;
---

<div
  class:list={['flex items-center gap-3 p-6 text-muted-foreground', className]}
  role="status"
  aria-live="polite"
>
  <span
    class="size-4 shrink-0 animate-spin rounded-full border-2 border-current border-t-transparent motion-reduce:animate-none"
    aria-hidden="true"></span>
  <span>{label}</span>
</div>
