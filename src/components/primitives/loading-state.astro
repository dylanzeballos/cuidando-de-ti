---
interface Props {
  label?: string;
  class?: string;
}

const { label = 'Cargando.', class: className = '' } = Astro.props;
---

<div class:list={['adm-skeleton', className]} role="status" aria-live="polite">
  <span class="adm-sr">{label}</span>
  <span class="adm-skeleton-line" style="width: 34%"></span>
  <span class="adm-skeleton-line" style="width: 72%"></span>
  <span class="adm-skeleton-line" style="width: 52%"></span>
  <span class="adm-skeleton-label">{label}</span>
</div>
