---
interface Props {
  title?: string;
  /** Id del encabezado del panel, para `aria-labelledby`. */
  labelledby?: string;
  class?: string;
}

const { title, labelledby, class: className = '' } = Astro.props;
---

<section
  class:list={['rounded-xl border border-border bg-card p-6 text-card-foreground shadow-sm', className]}
  aria-labelledby={labelledby}
>
  {title && <h2 id={labelledby} class="m-0 mb-4 text-lg font-medium">{title}</h2>}
  <slot />
</section>
