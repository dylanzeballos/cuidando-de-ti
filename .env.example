# URL privada del backend hermano (plataforma-core-api).
# Es una variable de servidor: nunca debe nombrarse con PUBLIC_ ni llegar al navegador.
API_BASE_URL=http://localhost:8080/api/v1

# Solo para desarrollo: dominio de empresa que se resuelve cuando la petición llega
# por localhost/127.0.0.1. En producción el dominio se toma del hostname de la petición.
DEV_SITE_DOMAIN=cuidando-de-ti.test

# Solo para desarrollo: usa el fixture local de marca y módulos
# (src/lib/fixtures.ts, con `cuidando-de-ti.test`) en lugar de la API real. En producción
# se ignora siempre. Déjalo sin definir para consumir el contrato real.
# SITE_FIXTURE=true

# Patrones de hostname que este despliegue confía como Host / X-Forwarded-Host.
# Sin ellos, Astro ignora la cabecera y usa 'localhost', así que la marca no se
# resolvería por dominio. Se leen al construir (astro.config.mjs). Incluye tus
# dominios de empresa o comodines, por ejemplo: acme.com,*.northwind.com
SITE_ALLOWED_DOMAINS=localhost,127.0.0.1

# Solo para desarrollo: usa el fixture local de administración de identidad
# (src/lib/admin/identity-fixture.ts) en lugar de la API real. En producción se
# ignora siempre. Déjalo sin definir para consumir el contrato real.
# IDENTITY_FIXTURE=true

# Solo para desarrollo: usa el fixture local de ventas y caja
# (src/lib/sales/fixtures.ts) en lugar de la API real. En producción se ignora
# siempre. Déjalo sin definir para consumir el contrato real.
# SALES_FIXTURE=true

# Solo para desarrollo: usa el fixture local de costos y gastos
# (src/lib/admin/costs-fixture.ts) en lugar de la API real. En producción se
# ignora siempre. Déjalo sin definir para consumir el contrato real.
# COSTS_FIXTURE=true

# La administración ya no usa un token fijo: se inicia sesión en /entrar y el
# servidor Astro (patrón BFF) guarda los tokens en `Astro.session`. El navegador
# solo recibe la cookie `cuidando_session` (HttpOnly, SameSite=Lax). La sesión usa
# el driver de sistema de archivos del adaptador de Node por defecto; para varias
# instancias, configura un driver externo (por ejemplo Redis).
